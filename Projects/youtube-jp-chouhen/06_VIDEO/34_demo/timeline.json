[
 {
  "start": 0.0,
  "end": 3.439,
  "text": "「あんたは、明日の出棺には出なくていいから」"
 },
 {
  "start": 3.939,
  "end": 8.504,
  "text": "「香典帳、書いたのはあんただろう。三十万、足りないんだ」"
 },
 {
  "start": 9.004,
  "end": 11.723,
  "text": "襖より先に、声が来た。"
 },
 {
  "start": 12.223,
  "end": 15.685,
  "text": "通夜の控室。線香が、まだ濃い。"
 },
 {
  "start": 16.185,
  "end": 19.276,
  "text": "香典箱は、まだ帯で封がしてある。"
 },
 {
  "start": 19.776,
  "end": 21.856,
  "text": "誰も、数えていない。"
 },
 {
  "start": 22.356,
  "end": 24.228,
  "text": "なのに、三十万。"
 },
 {
  "start": 24.728,
  "end": 27.471,
  "text": "私は、記帳の途中だった。"
 },
 {
  "start": 27.971,
  "end": 30.04,
  "text": "膝の上には、鞄。"
 },
 {
  "start": 30.54,
  "end": 33.607,
  "text": "中には、薬の説明書の束。"
 },
 {
  "start": 34.107,
  "end": 36.745,
  "text": "来週、役所に出す分だった。"
 },
 {
  "start": 37.245,
  "end": 40.219,
  "text": "手には、亮介さんの香典袋。"
 },
 {
  "start": 40.719,
  "end": 43.067,
  "text": "表書きの墨が、濃い。"
 },
 {
  "start": 43.567,
  "end": 46.519,
  "text": "中の札は、折り目が一つもない。"
 },
 {
  "start": 47.019,
  "end": 49.006,
  "text": "香典に、新札。"
 },
 {
  "start": 49.506,
  "end": 53.189,
  "text": "薄墨で書くのが、この土地の決まりだった。"
 },
 {
  "start": 53.689,
  "end": 56.06,
  "text": "急いで書いた字ではなかった。"
 },
 {
  "start": 56.56,
  "end": 59.279,
  "text": "「三十万。どこに隠した」"
 },
 {
  "start": 59.779,
  "end": 63.659,
  "text": "亮介さんが、白い紙を私の前に置いた。"
 },
 {
  "start": 64.159,
  "end": 67.331,
  "text": "表題に、見たことのない言葉があった。"
 },
 {
  "start": 67.831,
  "end": 69.424,
  "text": "遺贈、辞退。"
 },
 {
  "start": 69.924,
  "end": 72.91,
  "text": "「読まなくていい。名前だけ書け」"
 },
 {
  "start": 73.41,
  "end": 76.802,
  "text": "私は、香典袋を、エプロンに入れた。"
 },
 {
  "start": 77.302,
  "end": 78.651,
  "text": "「亮介さん」"
 },
 {
  "start": 79.151,
  "end": 81.905,
  "text": "「箱の帯は、いつ切るんですか」"
 },
 {
  "start": 82.605,
  "end": 86.275,
  "text": "この夜、亮介さんはまだ知らなかった。"
 },
 {
  "start": 86.275,
  "end": 89.551,
  "text": "まだ帯の封が切られていない箱のことも、"
 },
 {
  "start": 89.551,
  "end": 94.163,
  "text": "自分の香典袋に、何が一枚多く入っているのかも、"
 },
 {
  "start": 94.163,
  "end": 100.307,
  "text": "そして明日の十時、お義父さんの位牌を、誰が持つことになるのかも。"
 },
 {
  "start": 101.307,
  "end": 105.524,
  "text": "私が知っていたのは、金のことだけではない。"
 },
 {
  "start": 106.024,
  "end": 108.953,
  "text": "二年、私は天井を見ていた。"
 },
 {
  "start": 109.453,
  "end": 113.658,
  "text": "天井を見ている人間は、廊下の音を、よく覚える。"
 },
 {
  "start": 114.358,
  "end": 117.135,
  "text": "だから、この紙に書いておく。"
 },
 {
  "start": 118.335,
  "end": 122.312,
  "text": "里江さん。長いあいだ、悪かったなあ。"
 },
 {
  "start": 123.312,
  "end": 125.021,
  "text": "その言い方だった。"
 },
 {
  "start": 125.521,
  "end": 128.798,
  "text": "六年、毎晩、聞いた言い方だった。"
 },
 {
  "start": 129.298,
  "end": 131.993,
  "text": "私は、畳の縁を握った。"
 },
 {
  "start": 132.493,
  "end": 134.644,
  "text": "泣いてはいけないと思った。"
 },
 {
  "start": 135.144,
  "end": 137.433,
  "text": "まだ、出棺の前だった。"
 },
 {
  "start": 138.033,
  "end": 140.428,
  "text": "飯山さんが、紙を閉じた。"
 },
 {
  "start": 140.928,
  "end": 143.449,
  "text": "「遺言執行者は、私です」"
 },
 {
  "start": 143.949,
  "end": 147.504,
  "text": "「ご親族ではない者に、と、ご本人が」"
 },
 {
  "start": 148.004,
  "end": 151.524,
  "text": "広間の誰も、その意味を聞き返さなかった。"
 },
 {
  "start": 152.024,
  "end": 154.72,
  "text": "聞き返せない人が、二人いた。"
 },
 {
  "start": 155.52,
  "end": 158.181,
  "text": "とめさんが、前に崩れ落ちた。"
 },
 {
  "start": 158.681,
  "end": 161.981,
  "text": "膝から、そのまま、畳に手をついた。"
 },
 {
  "start": 162.481,
  "end": 163.784,
  "text": "「里江さん」"
 },
 {
  "start": 164.284,
  "end": 166.632,
  "text": "額を、畳につけた。"
 }
]
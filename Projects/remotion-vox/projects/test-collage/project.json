    "lines": [
      {
        "text": "オクラを、鍋のお湯でくたくたにゆでて、",
        "startMs": 0,
        "endMs": 3691
      },
      {
        "text": "冷たい水にさらして、それから刻む。",
        "startMs": 3691,
        "endMs": 6752
      },
      {
        "text": "——長年、そうしてこられた方。",
        "startMs": 6752,
        "endMs": 10061
      },
      {
        "text": "じつはそれ、オクラのいちばんの宝物を、",
        "startMs": 10061,
        "endMs": 13336
      },
      {
        "text": "お湯と流しに、捨てているかもしれません。",
        "startMs": 13336,
        "endMs": 16547
      }
    ],

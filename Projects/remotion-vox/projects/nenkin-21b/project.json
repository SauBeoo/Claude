 "sceneMarkers": [
  {
   "id": "sc-0",
   "atFrame": 0,
   "label": "この秋、あなたのお宅にも、扶養親族等申告書と"
  },
  {
   "id": "sc-1",
   "atFrame": 198,
   "label": "出すか出さないかで、一年に二万円。二十年なら"
  },
  {
   "id": "sc-2",
   "atFrame": 424,
   "label": "年金だけで暮らし、所得税を一円も払っていない"
  },
  {
   "id": "sc-3",
   "atFrame": 633,
   "label": "現役のころは、会社が全部やってくれていました"
  },
  {
   "id": "sc-4",
   "atFrame": 1376,
   "label": "落とし穴には、こういう問いが隠れています。出"
  },
  {
   "id": "sc-5",
   "atFrame": 1660,
   "label": "まず、事実から。"
  },
  {
   "id": "sc-6",
   "atFrame": 2014,
   "label": "対象は、年金を受け取っているかた。とくに、ご"
  },
  {
   "id": "sc-7",
   "atFrame": 2398,
   "label": "その前に、ひとつだけお願いです。お手元に封筒"
  },
  {
   "id": "sc-8",
   "atFrame": 3102,
   "label": "年金から税金が引かれはじめるのは、年に百五十"
  },
  {
   "id": "sc-9",
   "atFrame": 3391,
   "label": "その数字は、もう使われていません。"
  },
  {
   "id": "sc-10",
   "atFrame": 3609,
   "label": "こちらが、国税庁のパンフレットです。赤で囲ん"
  },
  {
   "id": "sc-11",
   "atFrame": 4202,
   "label": "六十五歳以上のかたは、二百五万円です。"
  },
  {
   "id": "sc-12",
   "atFrame": 4685,
   "label": "基礎控除という、誰にでも認められる控除があり"
  },
  {
   "id": "sc-13",
   "atFrame": 5135,
   "label": "一方で、年金を受け取るかたの控除、公的年金等"
  },
  {
   "id": "sc-14",
   "atFrame": 5817,
   "label": "そして、来年はまた上がります。令和九年分は、"
  },
  {
   "id": "sc-15",
   "atFrame": 6071,
   "label": "では、その紙を出すと、あなたの場合はいくら変"
  },
  {
   "id": "sc-16",
   "atFrame": 6275,
   "label": "当研究室のモニター、東京の高橋さん、六十五歳"
  },
  {
   "id": "sc-17",
   "atFrame": 6635,
   "label": "二百五万円を超えていますから、高橋さんの年金"
  },
  {
   "id": "sc-18",
   "atFrame": 6999,
   "label": "こういう場合、配偶者控除というものが使えます"
  },
  {
   "id": "sc-19",
   "atFrame": 7494,
   "label": "年金の支給額から、社会保険料を引く。そこから"
  },
  {
   "id": "sc-20",
   "atFrame": 8236,
   "label": "三十九万円に、五・一〇五パーセントを掛けます"
  },
  {
   "id": "sc-21",
   "atFrame": 8817,
   "label": "そういうことになります。"
  },
  {
   "id": "sc-22",
   "atFrame": 9483,
   "label": "配偶者の分が、ひと月三万二千五百円。扶養して"
  },
  {
   "id": "sc-23",
   "atFrame": 9981,
   "label": "七十八万円に、五・一〇五パーセントを掛けます"
  },
  {
   "id": "sc-24",
   "atFrame": 10455,
   "label": "家族の人数で、こんなに違うものなんですね。"
  },
  {
   "id": "sc-25",
   "atFrame": 10810,
   "label": "なお、さきほどから出てくる五・一〇五パーセン"
  },
  {
   "id": "sc-26",
   "atFrame": 11325,
   "label": "ここで、ふたつ目のお願いです。奥さま、ご主人"
  },
  {
   "id": "sc-27",
   "atFrame": 12138,
   "label": "日本年金機構のページを、要点だけまとめます。"
  },
  {
   "id": "sc-28",
   "atFrame": 12522,
   "label": "同じなら、何が変わるんですか。"
  },
  {
   "id": "sc-29",
   "atFrame": 13247,
   "label": "税率は同じで、引く前の額が大きくなる。だから"
  },
  {
   "id": "sc-30",
   "atFrame": 13465,
   "label": "そういう仕組みです。高橋さんの場合、その差が"
  },
  {
   "id": "sc-31",
   "atFrame": 13663,
   "label": "ここで、ひとつだけお願いです。今日の内容が分"
  },
  {
   "id": "sc-32",
   "atFrame": 14504,
   "label": "所得税がかからないのに、なぜ私にも紙が来るん"
  },
  {
   "id": "sc-33",
   "atFrame": 15238,
   "label": "税金を取りに来たのではなく、正しく計算するた"
  },
  {
   "id": "sc-34",
   "atFrame": 15806,
   "label": "機構のページの、要点はこうです。期限に間に合"
  },
  {
   "id": "sc-35",
   "atFrame": 16172,
   "label": "出し忘れても、あとから出せば、戻ってきます。"
  },
  {
   "id": "sc-36",
   "atFrame": 16622,
   "label": "還付の申告は、その年の翌年一月一日から、五年"
  },
  {
   "id": "sc-37",
   "atFrame": 16965,
   "label": "ただし、ここに、冒頭でお話しした落とし穴があ"
  },
  {
   "id": "sc-38",
   "atFrame": 17585,
   "label": "年金の収入が四百万円以下で、それ以外の所得が"
  },
  {
   "id": "sc-39",
   "atFrame": 17958,
   "label": "便利な制度に聞こえますよね。ところが、国税庁"
  },
  {
   "id": "sc-40",
   "atFrame": 18509,
   "label": "つまり、申告しなくていい、というのは、払いす"
  },
  {
   "id": "sc-41",
   "atFrame": 18988,
   "label": "冒頭の問いに、お答えします。出し忘れた二万円"
  },
  {
   "id": "sc-42",
   "atFrame": 19310,
   "label": "ここからは、多くのかたが気にされている点を、"
  },
  {
   "id": "sc-43",
   "atFrame": 19634,
   "label": "いいえ。配偶者の控除が、ひと月三万二千五百円"
  },
  {
   "id": "sc-44",
   "atFrame": 20303,
   "label": "では、ご家族が多いお宅ほど、差が開くわけです"
  },
  {
   "id": "sc-45",
   "atFrame": 20718,
   "label": "一。年金から所得税が引かれる線は、六十五歳以"
  },
  {
   "id": "sc-46",
   "atFrame": 21020,
   "label": "二。来年分は、さらに二百十四万円に上がる。"
  },
  {
   "id": "sc-47",
   "atFrame": 21450,
   "label": "四。配偶者の控除だけで、年におよそ二万円。二"
  },
  {
   "id": "sc-48",
   "atFrame": 21689,
   "label": "五。出し忘れても、五年以内なら確定申告で戻る"
  },
  {
   "id": "sc-49",
   "atFrame": 22026,
   "label": "最後に、みっつ目のお願いです。過去に出し忘れ"
  },
  {
   "id": "sc-50",
   "atFrame": 22311,
   "label": "なお、今日の内容は、令和八年八月時点の情報で"
  },
  {
   "id": "sc-51",
   "atFrame": 23224,
   "label": "年金を受け取っていたかたが亡くなると、必ず、"
  },
  {
   "id": "sc-52",
   "atFrame": 23998,
   "label": "次回の研究で、その手続きを、一緒に確かめます"
  }

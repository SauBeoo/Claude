 "captions": {
  "source": "srt-interpolated",
  "style": "outline",
  "enabled": true,
  "fontSize": 50,
  "lines": [
   {
    "text": "一度もこたつに座らなかった私が、今年、",
    "startMs": 0,
    "endMs": 3333
   },
   {
    "text": "はじめて座った日の話も。",
    "startMs": 3333,
    "endMs": 6067
   },
   {
    "text": "家事をしながら、ラジオのように、",
    "startMs": 6067,
    "endMs": 9000
   },
   {
    "text": "気楽に聞いてくださいね。",
    "startMs": 9000,
    "endMs": 11200
   },
   {
    "text": "うれしいはずなのに、口から出るのは、「すみません」。",
    "startMs": 23900,
    "endMs": 28333
   },
   {
    "text": "見張り番は、こうささやいています。「相手に、",
    "startMs": 28333,
    "endMs": 32200
   },
   {
    "text": "手間をかけさせたでしょう」。",
    "startMs": 32200,
    "endMs": 34667
   },
   {
    "text": "私が立っていたのは、デパートの呉服売り場です。今年、",
    "startMs": 34667,
    "endMs": 40133
   },
   {
    "text": "六十八になります。",
    "startMs": 40133,
    "endMs": 42033
   },
   {
    "text": "いまでも、いただき物の包装紙を、",
    "startMs": 42033,
    "endMs": 44900
   },
   {
    "text": "折り目どおりにたたんで、",
    "startMs": 44900,
    "endMs": 47100
   },
   {
    "text": "引き出しにしまってしまいます。",
    "startMs": 47100,
    "endMs": 49800
   },
   {
    "text": "ありがとうって言うと、なんだか、",
    "startMs": 49800,
    "endMs": 52633
   },
   {
    "text": "厚かましい気がしていたんです。",
    "startMs": 52633,
    "endMs": 55300
   },
   {
    "text": "売り場では、お客さまより先に頭を下げるのが、",
    "startMs": 55300,
    "endMs": 59700
   },
   {
    "text": "礼儀でした。",
    "startMs": 59700,
    "endMs": 60900
   },
   {
    "text": "私の見張り番は、きっと、",
    "startMs": 60900,
    "endMs": 63200
   },
   {
    "text": "そこで生まれたんだと思います。",
    "startMs": 63200,
    "endMs": 66067
   },
   {
    "text": "アメリカの研究では、感謝の手紙を書いた人は、",
    "startMs": 66567,
    "endMs": 70800
   },
   {
    "text": "受け取った相手のうれしさを、実際よりも、",
    "startMs": 70800,
    "endMs": 74633
   },
   {
    "text": "ずっと小さく見積もっていました。",
    "startMs": 74633,
    "endMs": 77700
   },
   {
    "text": "見張り番は、いつも、危ないほうに、",
    "startMs": 77700,
    "endMs": 81267
   },
   {
    "text": "多めに見積もるんですね。",
    "startMs": 81267,
    "endMs": 83767
   },
   {
    "text": "このままだと、謝られた相手は、「迷惑だったかな」と、",
    "startMs": 83767,
    "endMs": 89000
   },
   {
    "text": "かえって気をつかいます。親切が、",
    "startMs": 89000,
    "endMs": 92233
   },
   {
    "text": "そこで止まってしまうんです。",
    "startMs": 92233,
    "endMs": 95067
   },
   {
    "text": "去年の春、私は、バスで席をゆずってくれた高校生に、",
    "startMs": 123600,
    "endMs": 124000
   }
  ]
 },

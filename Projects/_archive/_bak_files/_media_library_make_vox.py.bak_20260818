def cmd_demo(a):
    out = Path(a.target)
    out.mkdir(parents=True, exist_ok=True)
    cache = out / "_cut"
    paths = []
    specs = demo_specs()
    if not a.img_dir:
        n0 = len(specs)
        specs = [v for v in specs if not v.get("_needs_photo")]
        if len(specs) < n0:
            print(f"[demo] bỏ {n0 - len(specs)} thẻ biến thể ảnh (không có --img-dir)")
    for i, v in enumerate(specs):
        v.pop("_needs_photo", None)
        reveal_check(v)
        bg_img, _ = prep_images(v, i, Path(a.img_dir) if a.img_dir else None, cache)
        p = build(v, out / f"vox_{i:02d}.mp4", bg_img, still_only=not a.mp4)
        if not a.mp4 and getattr(a, "sub_mock", False):
            mock_subs(Image.open(p).convert("RGB")).save(p)
        print(f"  [{i:02d}] {v['kind']:9s} → {Path(p).name}")
        paths.append(Path(p).with_suffix(".png") if a.mp4 else p)
    sheet(paths, out / "_vox_sheet.jpg", cols=a.cols)
    print(f"\n✅ {len(paths)} thẻ → {out}\n→ DUYỆT MẮT contact sheet trước khi mở cho video thật.")


# ══════════════════════════════════════════════════════════════════ SLIDES

def cmd_slides(a):
    slides = Path(a.target)
    clips = Path(a.clips_dir)
    clips.mkdir(parents=True, exist_ok=True)
    cfg = json.loads(slides.read_text(encoding="utf-8"))
    img_dir = Path(a.img_dir) if a.img_dir else clips.parent / (
        CH.get(a.channel)["img_subdir"] if a.channel else "slides_img")
    cache = clips / "_cut"
    only = set(a.only or [])
    n_title, made, skipped = 0, [], 0
    for i, e in enumerate(cfg):
        v = e.get("vox")
        if not v or (only and i not in only):
            continue
        if v.get("kind") == "title":
            n_title += 1
        reveal_check(v)
        bg_img, bg_path = prep_images(v, i, img_dir, cache)
        out = clips / f"clip_{i:02d}.mp4"
        sig_p = clips / f"clip_{i:02d}.sig"
        sig = _sig(v, bg_path)
        if not a.still and not a.force and out.exists() and sig_p.exists() \
                and sig_p.read_text(encoding="utf-8") == sig:
            print(f"  [{i:02d}] {v.get('kind'):9s} — không đổi, skip")
            skipped += 1
            made.append(out.with_suffix(".png"))
            continue
        p = build(v, out, bg_img, still_only=a.still)
        if a.still and getattr(a, "sub_mock", False):
            mock_subs(Image.open(p).convert("RGB")).save(p)
        if not a.still:
            sig_p.write_text(sig, encoding="utf-8")
        print(f"  [{i:02d}] {v.get('kind'):9s} → {Path(p).name}"
              + ("" if bg_path else ("  (nền phẳng)" if v.get("bg") == "photo" else "")))
        made.append(Path(p) if a.still else out.with_suffix(".png"))
    print(f"— dựng {len(made) - skipped} thẻ, skip {skipped} —")
    if n_title > TITLE_CAP:
        print(f"🔴 GATE VOX X1: {n_title} thẻ 'title' > trần {TITLE_CAP} → thẻ chữ đang thay "
              f"nội dung hình. Đổi sang flow/collage/stat (skill video-vox GĐ2).")
    if made:
        sheet([p for p in made if Path(p).exists()], clips / "_vox_sheet.jpg", cols=a.cols)


def cmd_sheet(a):
    d = Path(a.target)
    ps = sorted(d.glob("clip_*.png")) or sorted(d.glob("vox_*.png"))
    if not ps:
        raise SystemExit(f"[LỖI] không thấy PNG thẻ nào trong {d}")
    sheet(ps, d / "_vox_sheet.jpg", cols=a.cols)


def main():
    ap = argparse.ArgumentParser(description="Thẻ hình kiểu Vox — tool dùng chung mọi kênh")
    ap.add_argument("target", help="'demo' | 'sheet' | đường dẫn SLIDES.json")
    ap.add_argument("clips_dir", nargs="?", help="folder clips (bắt buộc khi target là SLIDES.json); "
                                                 "với demo/sheet là folder ra/vào")
    ap.add_argument("--channel", help="nạp hồ sơ vox từ channels.py (palette/font/safe_bottom)")
    ap.add_argument("--img-dir", help="folder ảnh nền (mặc định suy từ hồ sơ kênh)")
    ap.add_argument("--only", nargs="*", type=int, help="chỉ dựng vài slot")
    ap.add_argument("--still", action="store_true", help="chỉ xuất PNG frame cuối (duyệt nhanh)")
    ap.add_argument("--sub-mock", dest="sub_mock", action="store_true",
                    help="vẽ MOCK phụ đề pill 2 dòng lên PNG duyệt — kiểm 'không đè chữ "
                         "có nghĩa' + 'nửa dưới hết trống' trong một lần nhìn")
    ap.add_argument("--mp4", action="store_true", help="demo: xuất cả mp4, không chỉ PNG")
    ap.add_argument("--force", action="store_true", help="bỏ qua .sig, dựng lại hết")
    ap.add_argument("--cols", type=int, default=3, help="số cột contact sheet")
    ap.add_argument("--clip-sec", type=float,
                    help=f"độ dài clip (mặc định {CLIP_SEC:.0f}s = anim + giữ hình, renderer tự "
                         f"trim theo cue). Chỉ hạ khi làm DEMO xem chuyển động — clip ngắn hơn "
                         f"cue thì renderer LOOP, tức đoạn hoạt hoạ chạy lại giữa bài.")
    a = ap.parse_args()
    if a.clip_sec:
        globals()["CLIP_SEC"] = a.clip_sec

    if a.target in ("demo", "sheet") and not a.clips_dir:
        ap.error(f"'{a.target}' cần thêm đường dẫn folder")
    if a.target == "demo":
        a.target, a.clips_dir = a.clips_dir, None
        apply_profile(a.channel)
        return cmd_demo(a)
    if a.target == "sheet":
        a.target = a.clips_dir
        return cmd_sheet(a)
    if not a.clips_dir:
        ap.error("thiếu <clips_dir>")
    apply_profile(a.channel)
    cmd_slides(a)


if __name__ == "__main__":
    main()

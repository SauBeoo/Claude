# Cờ CLI ↔ khóa hồ sơ. Chỉ những cờ này được hồ sơ điền hộ.
# 6 khóa cuối = bộ nâng cấp thẩm mỹ 2026-07-29 (opt-in từng kênh, xem khối health).
# slide_style (2026-07-30): "wa" (card navy, mặc định) | "shiro" (nền TRẮNG kiểu
# ライフハック雑学 — telop trên + いらすとや giữa; đi cặp sub_style "telop").
FLAG_KEYS = ("speaker", "style", "speed", "intonation", "sub_style", "motion",
             "watermark", "bgm", "bgm_gain",
             "sub_size", "sub_accent", "motion_ease", "transition", "transition_dur",
             "final_crf", "slide_style", "voice_af",
             # engine (2026-08-02, kênh showa-b cần AivisSpeech): hồ sơ không có khóa
             # này → bỏ qua như cũ, mọi kênh hiện hữu giữ nguyên hành vi VOICEVOX.
             "engine")


def get(key):
    if key not in CHANNELS:
        raise SystemExit(f"[LỖI] không có kênh '{key}'. Có: {', '.join(CHANNELS)}")
    return CHANNELS[key]


def project_dir(key):
    return PROJECTS / get(key)["project"]


def palette(key):
    return PALETTES.get(key) or NAVY


def resolve_bgm(key):
    """Đường dẫn BGM tuyệt đối (hồ sơ ghi tương đối theo gốc project)."""
    p = get(key).get("bgm")
    return (project_dir(key) / p).resolve() if p else None


def img_dir(key, stem):
    """Folder ảnh TUYỆT ĐỐI — tự suy, khỏi gõ tay (đây là gốc lỗi video 20 goya)."""
    c = get(key)
    return (project_dir(key) / c["video_dir"] / stem / c["img_subdir"]).resolve()


def clips_dir(key, stem):
    c = get(key)
    return (project_dir(key) / c["video_dir"] / stem / "clips").resolve()

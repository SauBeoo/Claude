def main() -> int:
    plan = json.loads((VD / "plan28.json").read_text(encoding="utf-8"))
    shots = plan["shots"]

    lot = None
    if "--lot" in sys.argv:
        lot = int(sys.argv[sys.argv.index("--lot") + 1])
    lots = {1: range(0, 24), 2: range(24, 48), 3: range(48, 70), 4: range(70, 92)}

    miss = [s["k"] for s in shots if s["k"] not in SUBJ]
    if miss:
        print(f"🔴 THIẾU chủ thể cho ô: {miss}")
        return 1

    # gate: cam cac tu keo model ve phia ve mang trong (CLAUDE.md §Prompt anh)
    banned = [(k, w) for k, v in SUBJ.items()
              for w in ("blank", "empty", "text-free", "nothing")
              if w in v.lower()]
    if banned:
        print(f"🔴 SUBJ chua tu bi cam (keo model ve mang trong): {banned}")
        return 1

    flow, names, blocks = [], [], []
    for s in shots:
        k = s["k"]
        if lot and k not in lots[lot]:
            continue
        flow.append((STYLE_PRINT if k in PRINT else STYLE) + SUBJ[k] + ".")
        fn = f"img28_{k:03d}.png"
        names.append(f"dòng {len(flow):>3} -> {fn}   (ô {k}, ch{s['chap']}, {s['t0']:.0f}s)")
        blocks.append(f"## ô {k} · chương {s['chap']} · {s['t0']:.0f}s · "
                      f"{'PRINT' if k in PRINT else 'no-text'}\n"
                      f"lời: {s['text'][:70]}\n{SUBJ[k]}\n")

    tag = f"_LOT{lot}" if lot else ""
    (VD / f"img28_FLOW{tag}.txt").write_text("\n".join(flow) + "\n", encoding="utf-8")
    (VD / f"img28_TENFILE{tag}.txt").write_text("\n".join(names) + "\n", encoding="utf-8")
    (VD / f"img28_BLOCKS{tag}.md").write_text("\n".join(blocks), encoding="utf-8")

    L = [len(x) for x in flow]
    npr = sum(1 for s in shots if s["k"] in PRINT and (not lot or s["k"] in lots[lot]))
    print(f"→ {len(flow)} prompt · {min(L)}–{max(L)} ký · {npr} ô dùng STYLE_PRINT")
    print(f"  {VD / f'img28_FLOW{tag}.txt'}")
    print(f"  {VD / f'img28_TENFILE{tag}.txt'}")
    print(f"  {VD / f'img28_BLOCKS{tag}.md'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

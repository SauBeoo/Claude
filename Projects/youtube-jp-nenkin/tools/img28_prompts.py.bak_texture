# -*- coding: utf-8 -*-
r"""img28_prompts.py — sinh prompt ảnh cho 92 ô của video 28.

KHUÔN: y nguyên v27 (user đã gật 2026-09-17) — vector phẳng clip-art công ích Nhật, nền kem
#F6F1E4 một tông, đúng 3 màu + kem, không đổ bóng, guard CẤM CHỮ ở ~10% đầu prompt.

🔴 HAI STYLE, KHÔNG PHẢI MỘT (bài học v27, user soi lô 79 ảnh):
  ❌ LOẠI: chữ/số ĐỌC RA ĐƯỢC — kanji gen nát, số sai là vi phạm YMYL. Số do FONT builder vẽ.
  ✅ NHẬN & BẮT BUỘC ở ô có giấy tờ: chữ TEXTURE li ti không đọc nổi. Tờ giấy TRẮNG TRƠN LÀ SAI
     — nó làm 通知書 mất lý do tồn tại, người xem không hiểu ảnh nói gì.

🔴 BA LUẬT RIÊNG CỦA BÀI 28:
  1. **KHÔNG ô nào được dùng lưới lịch** — cả hai STYLE đều cấm `calendar grid`, và bài này nói
     rất nhiều về THÁNG (誕生月・10月・2年後). Mọi mốc thời gian tả bằng **dải ngang có mốc**
     hoặc **tờ ghi chú dán tường**, không bao giờ bằng lịch.
     ⚠️ Đây đúng ca `ai-video-regen.md` §3: *vật mời gọi thắng câu cấm* — lưới lịch thì model
     sẽ điền số vào, bất kể câu cấm. Cách chắc là BỎ VẬT.
  2. **Trục 封筒 phải nhận ra được xuyên bài** (ô 3 · 65 · 76 · 88): cùng một phong bì nâu nhạt
     nằm ngang, cùng góc nhìn — nó là vật trục của kịch bản v2.
  3. ⛔ **Cấm mọi chữ `blank` / `empty` / `text-free` trong mô tả** (`CLAUDE.md` §Prompt ảnh):
     mấy từ đó kéo model về phía vẽ mảng trống. Tả **cái CÓ MẶT**.

CHẠY:  python tools/img28_prompts.py            → 3 file trong 06_VIDEO/<stem>/
       python tools/img28_prompts.py --lot 2    → chỉ in lô 2
"""
import io
import json
import sys
from pathlib import Path

sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")

PROJ = Path(__file__).resolve().parents[1]
STEM = "28_kouki-75sai-tanjyotsuki-hokenryo"
VD = PROJ / "06_VIDEO" / STEM

_BASE = ("Flat vector illustration in the style of Japanese public-information clip art. "
         "Plain flat cream background #F6F1E4, single tone, no gradient, no vignette, "
         "no drop shadows. Only three colors plus cream: navy #1F3864, warm red #C0392B, "
         "muted teal #3E7C78. Even line weight, rounded shapes, simple faces. "
         "Composition: subject centered and filling most of the frame, small even cream "
         "margin on all four sides. 16:9. SUBJECT: ")

STYLE = ("NO TEXT, NO LETTERS, NO NUMBERS, NO SIGNAGE, NO CALENDAR GRID, NO CLOCK FACE "
         "anywhere in the image. " + _BASE)

STYLE_PRINT = (
    "Every sheet of paper, form, book, bankbook, postcard, notice and document in this image "
    "MUST LOOK PRINTED AND FILLED IN: cover them with FINE ILLEGIBLE TEXT TEXTURE — many rows "
    "of tiny faint grey marks suggesting Japanese characters, far too small to read — plus "
    "faint ruled lines, a few small boxes and a column of tiny marks along one edge. "
    "A blank white sheet is WRONG. But NO large readable words, NO readable numbers, "
    "NO headline text, NO signage, NO logos, NO calendar grid, NO clock face. " + _BASE)

# 🔴 CỐ Ý LỆCH MỐC 15% CỦA `ai-video-regen.md` §2 — đo được: guard 「NO large readable words」
# của STYLE_PRINT nằm ở **34–35%** prompt (24/92 prompt), trong khi §2 đòi ≤15%.
# KHÔNG sửa, và đây là lý do:
#   · §2 nói về prompt CẤM THUẦN. STYLE_PRINT thì **xin một loại chữ và cấm loại khác** —
#     nó phải nói 「MUST LOOK PRINTED + FINE ILLEGIBLE TEXT TEXTURE」 TRƯỚC, rồi mới cấm chữ
#     đọc được. Đảo lại là quay về đúng bệnh bản đầu v27: tờ 通知書 trắng trơn, sổ ngân hàng
#     trắng trơn — user đã bác bằng mắt trên lô 79 ảnh.
#   · Chính `ai-video-regen.md` §5 ghi cặp câu này là **hai câu chọi nhau**, và §2 cảnh báo
#     「chỉ nâng MỘT trong ba luật rồi tưởng đã xong」 ⇒ nâng bừa là đổi một khuôn ĐÃ nghiệm thu
#     lấy một con số chưa ca nào chứng minh ở ngữ cảnh này.
#   · Khuôn này đã gen ra 79 ảnh đạt ở v27 ⇒ nó là **mẫu nó học từ**; gate đánh trượt mẫu nó
#     học từ thì nghi gate trước (memory `feedback_gate_phai_qua_duoc_mau_no_hoc_tu`).
# ⚠️ ĐIỀU KIỆN: vẫn phải **gen LÔ THỬ ~6 ô PRINT trước** (3,4,16,42,77,82) và soi 1:1 xem có
# chữ đọc được không. Nếu lô thử ra chữ đọc được thì lúc đó mới bàn nâng guard — và phải nâng
# bằng cách GỘP 「NO readable words … Instead, every sheet MUST LOOK PRINTED …」 thành MỘT khối
# đứng đầu, chứ không phải chỉ dời câu cấm lên.

# ô có vật IN ẤN ⇒ STYLE_PRINT
PRINT = {3, 4, 5, 11, 12, 16, 18, 19, 23, 31, 33, 40, 42, 43, 56, 59, 61,
         76, 77, 79, 80, 82, 84, 88}

# ── CHỦ THỂ TỪNG Ô — rút từ lời đọc của chính ô đó ───────────────────────────

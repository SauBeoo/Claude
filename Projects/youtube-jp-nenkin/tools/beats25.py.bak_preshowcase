    io.open(os.path.join(VD, "vox25_LOT1.txt"), "w", encoding="utf-8").write(
        "\n".join(merged[i].replace("\n", " ") for i, _b, _s, _k in lot) + "\n")
    io.open(os.path.join(VD, "vox25_LOT1_TENFILE.txt"), "w", encoding="utf-8").write("\n".join(
        f"dong {j+1:>2} -> clips/clip_{k}.mp4   [beat {b['id']} · "
        f"{b['title_en'].split('· ')[1]} · {s['shot_size']} · {s['dur']:.1f}s]  {b['title_cn']}"
        for j, (_i, b, s, k) in enumerate(lot)) + "\n")

    L = [len(p) for p in merged]
    print(f"\n📁 ĐÃ ĐỔ VỀ {VD}")
    print(f"   vox25_FLOW.txt        {len(merged):>3} prompt — MỘT prompt/clip (poster + "
          f"chuyển động gộp chung), {min(L)}–{max(L)} ký")
    print(f"   vox25_TENFILE.txt         sổ dòng ↔ clips/clip_<key>.mp4")
    print(f"   vox25_LOT1.txt            {len(lot)} shot GEN THỬ TRƯỚC (đủ "
          f"{len(seen)} khuôn: {' '.join(seen)})")
    print(f"   vox25_PROMPTS.md · vox25_beats.json")


if __name__ == "__main__":
    main()

# OUTPUT
# =====================================================================================
def write_outputs(rows, outdir=".", prefix="videogen", only=None, prof=None):
    """FLOW.txt (1 prompt/1 dong, bom extension) · TENFILE.txt (thu tu <-> ten clip) · BLOCKS.md (nguoi doc)."""
    sel = [r for r in rows if (only is None or r[0] in only)]
    os.makedirs(outdir, exist_ok=True)
    with io.open(os.path.join(outdir, f"{prefix}_FLOW.txt"), "w", encoding="utf-8") as f:
        for r in sel: f.write(r[5] + "\n")
    with io.open(os.path.join(outdir, f"{prefix}_TENFILE.txt"), "w", encoding="utf-8") as f:
        f.write("# dong FLOW.txt  ->  ten file clip  (thu tu PHAI khop)\n")
        for i, r in enumerate(sel, 1):
            f.write(f"{i:>3}  clip_{r[0]}_{r[1].lower()}_{r[2]}.mp4   [{r[3]}]\n")
    with io.open(os.path.join(outdir, f"{prefix}_BLOCKS.md"), "w", encoding="utf-8") as f:
        f.write(f"# {prefix} — ban nguoi doc (6 khoi, thu tu co dinh)\n\n")
        _ST, _MO, _MOX, _AV = _prof(prof)
        f.write("STYLE: " + _ST + "\n\nMOTION: " + _MO + "\n\nAVOID: " + _AV + "\n\n---\n\n")
        for i, r in enumerate(sel, 1):
            act = r[5].split(", " + r[4])[0]
            f.write(f"## {i}. {r[0]} [{r[1]} · {r[2]} · {r[3]}]\n\nACT: {act}\n\nFRAMING: {r[4]}\n\n")
    print(f"da ghi {prefix}_FLOW.txt ({len(sel)} dong) · {prefix}_TENFILE.txt · {prefix}_BLOCKS.md ->", outdir)


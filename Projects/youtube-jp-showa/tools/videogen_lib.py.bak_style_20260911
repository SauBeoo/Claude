def act_fams(act):
    """Tra ve set ho dong tac cua mot ACT (mot ACT co the thuoc nhieu ho)."""
    return {k for k, r in ACT_RE.items() if r.search(act or "")}

def act_report(S, C, quiet=False):
    """Dem ho dong tac tren ca video. Tra ve (n_red, dict dem)."""
    import collections
    cnt = collections.Counter(); manip_only = 0; joy = 0
    for s in S:
        f = act_fams(expand(s[2], C))
        for k in f: cnt[k] += 1
        if f == {"MANIP"} or (f and f <= {"MANIP", "MOVE"}): manip_only += 1
        if f & {"SOCIAL", "PLAY", "EAT"}: joy += 1
    n = max(1, len(S))
    red, warn = [], []
    # ⚠️ TRAN MANIP la nguong DOAN (khong co so do cua nganh) => CANH BAO, khong CHAN.
    #    De no CHAN thi moi video se do man, roi bi bo qua — dung benh "luat kiem bang mat se troi".
    if manip_only / n > MANIP_MAX:
        warn.append(f"{manip_only}/{n} shot ({manip_only*100//n}%) chi co MANIP/MOVE — "
                    f"tran DE XUAT {int(MANIP_MAX*100)}%. Benh 'nhac len ha xuong'")
    # 🔴 CHOT 2026-09-11 — user: "y la dung cho nhung script co canh do, chu khong phai
    #    them vo toi va". => MOI nguong duoi day la CANH BAO, khong CHAN. Vi neu chan thi
    #    chinh cai gate nay ep nguoi viet NHET canh vao script khong co beat do — dung cai
    #    user vua kết an. Gate chi hoi "script nay co beat vui choi ma minh bo qua khong?";
    #    script THAT SU khong co thi sua o tang SCRIPT, khong nhet canh o tang prompt.
    if joy < SOCIAL_MIN:
        warn.append(f"chi {joy} shot co SOCIAL/PLAY/EAT (nguong tham khao {SOCIAL_MIN}). "
                    f"Doc lai loi ke: co beat quay quan nao bi bien thanh 'mot nguoi xu ly mot vat' "
                    f"khong? Neu script that su khong co thi BO QUA canh bao nay")
    if len(cnt) < FAM_MIN:
        warn.append(f"chi {len(cnt)} ho dong tac ({sorted(cnt)}) — tham khao >= {FAM_MIN}")
    for _f, _n in (("STROLL", 4), ("VEHICLE", 4)):
        if cnt[_f] < _n:
            warn.append(f"chi {cnt[_f]} shot co {_f} (tham khao >= {_n}) — CHI them khi script "
                        f"co beat do; ⛔ dung nhet de lam xanh gate")
    if not quiet:
        print(f"{'ho dong tac':20}: " + " · ".join(f"{k} {v}" for k, v in cnt.most_common()))
        print(f"{'chi MANIP/MOVE':20}: {manip_only}/{n} ({manip_only*100//n}%)  "
              f"[tran de xuat {int(MANIP_MAX*100)}%]")
        print(f"{'co VUI CHOI/QUAY QUAN':20}: {joy} shot  [can >= {SOCIAL_MIN}]")
    return red, warn, cnt




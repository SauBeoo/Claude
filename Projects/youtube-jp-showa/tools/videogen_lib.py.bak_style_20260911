# ACT/preset da tu ta dam dong roi thi chi can dan LOC VO DANH, dung ta lai lan hai:
# canh K5 tung ra "figures pressed together in the crowded carriage" + preset "crowded train"
# + extras "packed solid" = noi CHAT CUNG ba lan trong mot prompt.
HAS_CROWD = re.compile(r"\b(crowded|packed with|packed solid|queue|a line of figures|figures in|other (?:passengers|workers|customers|bathers|colleagues)|group of|crowd)\b", re.I)

def _extras(preset, level, act=""):
    """level: 'solo' | 'few' | 'full' | ('solo','ly do') | None(=few neu la noi cong cong).
    Tra ve (chuoi_chen, level, ly_do)."""
    why = ""
    if isinstance(level, (tuple, list)):
        level, why = (level[0], level[1] if len(level) > 1 else "")
    if level is None:
        level = "few" if preset in PUBLIC_PRESETS else "solo"
    if level == "solo":
        return "", level, why
    few, full = EXTRAS.get(preset, ("", ""))
    s = full if level == "full" else few
    if not s:
        return "", level, why
    if HAS_CROWD.search(act or ""):
        return EXTRA_LOCK, level, why          # da co dam dong trong ACT -> chi khoa vo danh
    return f"{s}, {EXTRA_LOCK}", level, why




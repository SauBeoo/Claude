#  ② CHU NGU LA BONG/ANH SANG/BUI thi dong tu di chuyen la CHUYEN DONG PHU, khong phai nguoi di,
#     nen khong can huong camera: "the shadow CROSSES his arm" bi bat oan.
SUBJ_AMBIENT = re.compile(r"\b(shadow|shadows|light|dust|steam|smoke|breeze|wind|curtain|air|"
                          r"reflection|sunlight|daylight)\b[^,.]{0,28}?\b(?:cross\w*|move\w*|"
                          r"travel\w*|creep\w*|slid\w*|run\w*|pass\w*)\b", re.I)
# ('drift' bo khoi MOVE_VERBS: 'dust drifts' la chuyen dong PHU, bat oan canh 24)
# 🔴 2026-09-10: them "towards" (Anh-Anh). TOWARD_CAM ngay duoi da nhan `toward(s)?` tu dau,
#    DIRECTION thi khong => ACT viet "towards the camera" bi cham la THIEU HUONG. Lo cua gate,
#    khong phai loi cua nguoi viet.
DIRECTION   = re.compile(r"towards? the camera|away from the camera|left to right|right to left|across the frame|"
                         r"past the camera|into (?:the )?frame|out of (?:the )?frame|out of sight|"
                         r"from the far end|to the far end|down the lane|up the lane|deeper into|"
                         r"getting smaller|growing smaller|growing larger|from behind|in place|on the spot", re.I)
SECONDARY   = re.compile(r"breeze|wind|sway|swings|swinging|flutter|ripple|dust|steam|smoke|shadow|shadows|"
                         r"shifts (?:his|her|its)? ?weight|weight shift|drips|dripping|drops|bounc|rustl|flap|stirring|"
                         r"catch(?:es|ing) the light|light (?:moves|spreading|spreads)|glint|curtain|hair|cloth|"
                         r"sleeve|hem|leaves|grass|awning|drift", re.I)
BAD_POSE    = re.compile(r"leans? out of|bends? double|contort|upside down|hangs? from|lean(?:s|ing)? far out|"
                         r"twists? around|spins?|somersault|jumps? over the camera", re.I)
FACE_CAM    = re.compile(r"looks? (?:straight )?(?:at|into) the camera|faces? the camera|turns? to (?:face|look at) the camera|"
                         r"smiles? at the camera|eye contact", re.I)
POSSESSIVE  = re.compile(r"A_[A-Z]+'s")
PLAIN_WORDS = ("plain", "unmarked")


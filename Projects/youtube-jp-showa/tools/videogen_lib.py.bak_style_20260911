# §11 CHUOI HANH DONG (chain) + §12 CAST LOCK — chot 2026-09-06
#   user: "hanh dong cua prompt truoc phai duoc noi lien voi hanh dong cua prompt sau"
#         "kich ban phai dong nhat nhan vat, video phai nhat quan"
#
# 🔴 GIOI HAN THAT, noi truoc khi hua: t2v gen TUNG clip TU DAU, KHONG co character-lock.
#    Cung mot cau chu van ra hai khuon mat khac nhau. Nen "dong nhat" o day = dong nhat
#    NHUNG THU MODEL GIU DUOC: mau mu · mau ao · mau/chat lieu vat deo · huong di · boi
#    canh · anh sang. Bang chung video 10: clip GIAU MAT (H1, 13:14, C3 vong 5) dong nhat
#    tuyet doi; clip THAY MAT thi moi lan mot nguoi khac.
#    => Nhan vat tai xuat hien >= 2 clip thi PHAI giau mat.
# =====================================================================================
# 🔴 CHOT 2026-09-07 — DO DEMO 5 CLIP: noi bang CHU KHONG GIU DUOC BOI CANH.
#   chuoi A (2 clip cung preset "duong dem mua"): clip 2 ra BAN NGAY, ngo KHAC.
#   chuoi B (3 clip cung preset "van phong"):     ra BA van phong khac nhau.
#   => CONT_LEAD/CHAIN_LOCK van giu trong thu vien (dung duoc neu doi sang tool co frame-dau),
#      nhung MAC DINH TAT. Cach noi thuc te: xem WIDE_FRAMINGS + gate V1 ben duoi.
USE_CHAIN_LOCK = False

CONT_LEAD = "continuing in the same place a moment later, {out}, and "

# KHOA CU MAY — chen vao MOI canh khong phai dau chuoi. Khong co Extend (phai bam tay trong UI
# Flow, ma user gen bang tool ngoai) thi day la don bay MANH NHAT con lai bang text: bao thang
# cho model rang day la CUNG mot cu may, CUNG anh sang voi canh truoc.
# Ba thu mat bat ngay o cho cat: goc may · huong nang · co chu the trong khung.
CHAIN_LOCK = ("the camera has not moved since the previous shot, the same lens height and the same "
              "distance to the subject, the light comes from the same direction and the shadows fall "
              "the same way")

# framing GIAU MAT — an toan cho nhan vat tai xuat hien
FACE_HIDDEN = {"behind", "ots", "high"}
HIDE_WORDS = re.compile(r"seen from behind|from behind|back to the camera|looking down|"
                        r"head bowed|over the shoulder", re.I)
# huong di — dung de chan cu LAT NGUOC giua hai canh lien nhau trong cung chuoi
TOWARD_CAM = re.compile(r"toward(s)?\s+the\s+camera|approach(es|ing)\s+the\s+camera|"
                        r"walks?\s+up\s+to\s+the\s+camera", re.I)
AWAY_CAM = re.compile(r"away\s+from\s+the\s+camera|from\s+behind|grow(s|ing)?\s+smaller", re.I)
CAST_TOKEN = re.compile(r"A_([A-Z0-9]+)")
MAX_CAST_IN_SCENE = 2      # >2 nguoi trong mot canh = moi lan gen mot kieu
MAX_CAST_IN_VIDEO = 3      # tran nhan vat CO TEN cho ca video


HEAD_NOUNS = ("figure", "woman", "man", "workman", "shopkeeper", "person")


def short_ref(act, C):
    """Trong menh de NOI TIEP, A_XXX -> 'the same figure/woman/...' thay vi bung ca mo ta.
    Vi sao: ① prompt khong phinh ② chu 'the same' chinh la thu noi voi model rang DAY LA
    CUNG MOT NGUOI voi canh truoc — bung lai mo ta dai chi lam model ve lai tu dau."""
    def rep(m):
        d = (C.get(m.group(1).lower()) or "").lower()
        for n in HEAD_NOUNS:
            if n in d:
                return f"the same {n}"
        return "the same person"
    return CAST_TOKEN.sub(rep, act)


PLATE_REF = "matching the reference image exactly"


def plate_for(act, plates):
    """Canh nay dung ANH THAM CHIEU cua NHAN VAT nao?

    Tool chi nhan 1 ANH -> moi clip khoa duoc DUNG MOT nhan vat. Chon theo thu tu uu tien
    trong `plates` (dict giu thu tu khai bao), lay nguoi dau tien co mat trong canh.
    """
    if not plates:
        return None, None
    toks = set(CAST_TOKEN.findall(act))
    for tok, path in plates.items():
        if tok.upper() in toks:
            return tok.upper(), path
    return None, None


def expand_with_plate(act, C, tok):
    """Nhan vat DA co anh tham chieu thi KHONG ta lai quan ao/mau nua.

    🔴 Vi sao: dua ca ANH lan MO TA DAI la cho model hai nguon co the mau thuan, no se tron
    hai thu lai. Anh cho HINH DANG, chu cho HANH DONG. Nhan vat co plate -> 'the figure
    matching the reference image exactly'; nhan vat khong co plate -> bung mo ta day du.
    """
    def rep(m):
        t = m.group(1)
        if t.upper() == tok:
            d = (C.get(t.lower()) or "").lower()
            for n in HEAD_NOUNS:
                if n in d:
                    return f"the {n} {PLATE_REF}"
            return f"the person {PLATE_REF}"
        return C.get(t.lower(), m.group(0))
    return CAST_TOKEN.sub(rep, act)


def plate_prompt(tok, C, extra=""):
    """Prompt de GEN tam anh tham chieu cua mot nhan vat.

    Anh nay se di kem MOI clip co nhan vat do, nen no phai la anh DE HOC:
      · dung yen, toan than, chinh dien hoi cheo 3/4 -> model thay du quan ao + ti le nguoi
      · nen TRON, sang, khong do dac -> khong hoc nham boi canh vao nhan vat
      · anh sang deu, khong do bong gat -> khong khoa nham mot huong nang
      · CUNG STYLE voi clip (cung palette 1970s) -> khong lech tong khi ghep
    ⛔ Khong ta mat/tuoi/toc o day nua — chinh tam anh se quyet dinh nhung thu do, va do la
       diem cua ca cach lam nay: chuyen viec giu khuon mat tu CHU sang ANH.
    """
    d = C[tok.lower()]
    return (f"full-body reference photograph of {d}, standing still and relaxed, "
            f"three-quarter view facing slightly toward the camera, arms at the sides, "
            f"plain seamless light grey studio background, no props, no furniture, no scenery, "
            f"even soft frontal light with no harsh shadows, sharp focus, the whole body from "
            f"head to shoes inside the frame with a little space above the head, "
            f"{STYLE}{(', ' + extra) if extra else ''}. {AVOID}.")


def write_plate_prompts(C, plates, outdir=".", prefix="cast_plates"):
    """Xuat prompt gen anh cho tung nhan vat co trong `plates` (1 prompt / 1 dong)."""
    lines, names = [], []
    for tok, path in plates.items():
        lines.append(" ".join(plate_prompt(tok, C).split()))
        names.append(f"{len(names) + 1:3d}  {os.path.basename(path)}   (A_{tok.upper()})")
    io.open(os.path.join(outdir, f"{prefix}_FLOW.txt"), "w", encoding="utf-8").write("\n".join(lines) + "\n")
    io.open(os.path.join(outdir, f"{prefix}_TENFILE.txt"), "w", encoding="utf-8").write(
        "# dong FLOW.txt  ->  ten file anh  (thu tu PHAI khop)\n" + "\n".join(names) + "\n")
    print(f"da ghi {prefix}_FLOW.txt ({len(lines)} dong) · {prefix}_TENFILE.txt -> {os.path.abspath(outdir)}")
    return lines


def plate_map(S, plates):
    """{sid: duong dan anh} — de xuat ra file cho nguoi gen biet clip nao dinh kem anh nao."""
    out = {}
    for row in S:
        r = _srow(row)
        tok, path = plate_for(r[2], plates)
        if path:
            out[r[0]] = path
    return out


# Framing RONG = thay ca can phong -> hai canh rong lien tiep thi mat CHO nó khop, va no khong khop.
# Framing CHAT = than nguoi choan khung, phong nen it/mo -> doi phong KHONG AI BIET.
# Day la cho GIAU su thay doi. Ngu phap dung phim: rong -> chat -> rong.
WIDE_FRAMINGS  = {"wide", "behind", "pan", "high", "still"}
TIGHT_FRAMINGS = {"medium", "ots", "low", "tilt"}


def autochain(S, cut=(), min_run=2):
    """NOI LIEN LA MAC DINH, KHONG phai tuy chon.

    Tu dong gom cac canh LIEN NHAU cung (khoi, preset) thanh mot chuoi. Nguoi viet chi con
    phai lam MOT viec: dien 'out' (trang thai ket) cho moi canh khong phai canh cuoi chuoi —
    va gate se doi cho bang duoc. Muon CAT HAN (doi canh, doi thoi diem) thi bo sid vao `cut`.

    Vi sao dao mac dinh (do tren video 10): 57/120 cap canh dung ngay canh nhau, CUNG khoi,
    CUNG boi canh — ma van la 57 canh roi, vi 'chain' luc do la tuy chon nen khong ai khai.
    """
    cut = set(cut)
    rows = [list(_srow(x)) for x in S]
    i, n = 0, len(rows)
    while i < n:
        j = i
        while (j + 1 < n and rows[j + 1][0] not in cut
               and rows[j + 1][1] == rows[i][1] and rows[j + 1][3] == rows[i][3]):
            j += 1
        if j - i + 1 >= min_run:
            cid = f"auto_{rows[i][0]}"
            for k in range(i, j + 1):
                if not rows[k][6]:
                    rows[k][6] = cid
        i = j + 1
    return [tuple(r) for r in rows]


def linkage(S):
    """Do DO AN TOAN CUA MOI NOI (doi nghia 2026-09-07, sau khi do demo).

    Truoc: dem xem co khai chain/out chua. Nhung do thuc te cho thay chain/out KHONG giu
    duoc boi canh, nen dem no la dem mot thu khong co that.
    Nay: dem xem moi noi giua hai canh CUNG BOI CANH co it nhat MOT canh CHAT hay khong —
    do la thu that su giau duoc viec model doi can phong.
    """
    R = [_srow(x) for x in S]
    safe = risky = 0
    for a, b in zip(R, R[1:]):
        if a[1] == b[1] and a[3] == b[3]:
            risky += 1
            if a[4] in TIGHT_FRAMINGS or b[4] in TIGHT_FRAMINGS:
                safe += 1
    return safe, risky, (100.0 * safe / risky if risky else 100.0)


def _srow(row):
    """6-tuple (cu) / 8-tuple / 9-tuple: (sid, blk, act, preset, cam, tier, chain, out, crowd)."""
    if len(row) >= 9:
        return row[0], row[1], row[2], row[3], row[4], row[5], row[6], row[7]
    if len(row) >= 8:
        return row[0], row[1], row[2], row[3], row[4], row[5], row[6], row[7]
    return row[0], row[1], row[2], row[3], row[4], row[5], None, None


def _crowd_of(row, crowd):
    """Muc dam dong cua MOT shot: truong thu 9 cua tuple thang map theo preset.

    🔴 KHONG truyen `crowd` => tra ve 'solo' cho MOI shot, tuc lop EXTRAS TAT HOAN TOAN.
    Co y: video da gen truoc 2026-09-10 goi build() khong co `crowd`, va neu de mac din
    'few' cho PUBLIC_PRESETS thi prompt cua chung DOI im lang (preset ten 'office' o
    video khac se tu nhien co nguoi nen). Cung nguyen tac voi `prof`: khong video cu nao
    phai gen lai."""
    if len(row) >= 9 and row[8] is not None:
        return row[8]
    if not crowd:
        return "solo"
    return crowd.get(row[3], "solo")



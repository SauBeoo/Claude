def gate(rows, S, P, C, whitelist_no_human=None, interior=None, strict=True, quiet=False,
         prof=None, chain_strict=None, crowd=None):
    """In bang + return (n_red, n_warn). strict=True: 3 nhip + chuyen dong phu la 🔴 (video moi);
    strict=False: chi ⚠️ (video da gen, chi vá clip loi).

    chain_strict: rieng cho luat CHUOI (canh roi C6). Mac dinh = strict.
      Video VIET TRUOC luat chuoi (video 10) dat chain_strict=False de khong bi bat oan,
      nhung VAN giu strict cho 3 nhip / chuyen dong phu / huong camera.
      ⛔ Video 11 tro di KHONG duoc dat False — do la ca luat, khong phai tuy chon."""
    if chain_strict is None:
        chain_strict = strict
    wl = whitelist_no_human or {}
    interior = interior or set()
    acts = {s[0]: s[2] for s in S}
    cams = {s[0]: s[4] for s in S}
    SR = [_srow(x) for x in S]                       # (sid, blk, act, preset, cam, tier, chain, out)
    idx = {r[0]: i for i, r in enumerate(SR)}
    red, warn = [], []
    def R(sid, why): red.append((sid, why))
    def W(sid, why): warn.append((sid, why))

    ids = [r[0] for r in rows]
    for k, v in collections.Counter(ids).items():
        if v > 1: R(k, f"id trung {v} lan")

    for sid, blk, pre, tier, cam, prompt in rows:
        act = acts[sid]; al = act.lower(); pl = prompt.lower(); cl = cam.lower()
        # 1 so huu cach tren token cast
        if POSSESSIVE.search(act): R(sid, "A_XXX's -> expand hong ngu phap")
        # 2 filter tre em
        if any(w in pl for w in CHILD_WORDS): R(sid, "tu tre em (filter Veo)")
        # 3 framing cam / khong co than
        if bad_framing(cl):
            R(sid, f"framing KHONG CO THAN: '{cam[:40]}'")
        elif cams[sid] not in FRAMINGS and not BODY_WORDS.search(cl) and "no people" not in cl:
            W(sid, f"framing tu do, khong neu than nguoi: '{cam[:40]}'")
        # 4 khong co nguoi
        has_human = any(w in pl for w in HUMAN_WORDS)
        if not has_human and sid not in wl: R(sid, "KHONG co nguoi/tay (khong whitelist)")
        # 5b VAT DI VAO TRONG VAT KHAC (§5.6) — model khong dung duoc canh vat bien mat
        _om = OCCLUDE.search(al)
        if _om:
            (R if strict else W)(sid, f"VAT BIEN MAT vao trong vat khac: '{_om.group(0)[:46]}' — "
                                      f"model xuyen tay/nhan ban vat. Xem §5.6, dung 1 trong 3 khuon "
                                      f"an toan (ap len NGOAI · keo VAI trum len · dat CHONG len)")
        # 5 di chuyen ma khong co huong camera
        al_h = SUBJ_AMBIENT.sub(" ", al)      # bo cum chuyen dong PHU truoc khi do
        if MOVE_VERBS.search(al_h) and not DIRECTION.search(al):
            (R if strict else W)(sid, "di chuyen khong co HUONG tuong doi camera (H1 quay mat lai vi thieu cai nay)")
        # 6 nhin/quay ve camera
        if FACE_CAM.search(al): R(sid, "nhin/quay ve camera")
        # 7 tu the cam
        if BAD_POSE.search(al): R(sid, "tu the phuc tap (leans out/bends double/...)")
        # 8 ba nhip
        n_then = al.count(", then ")
        if n_then == 0: R(sid, "0 'then' — mot nhip = canh do")
        elif n_then == 1: (R if strict else W)(sid, "chi 1 'then' — can 2 (3 nhip)")
        # 9 chuyen dong phu (co hon)
        if has_human and not SECONDARY.search(al): (R if strict else W)(sid, "khong co chuyen dong PHU (breeze/sway/dust/shadow/weight)")
        # 11 VAT ROI tren mat dat + nguoi nhat len => model nhan ban vat (xem GROUND_OBJ)
        _ground = GROUND_OBJ.search(act) and not GROUND_NEG.search(act)
        if has_human and _ground and PICK_UP.search(act):
            R(sid, "VAT ROI duoi dat + hanh dong NHAT LEN -> model nhan ban vat, thiet ke lai canh")
        elif has_human and _ground:
            W(sid, "co VAT ROI duoi dat — de bi nhan ban, uu tien vat DEO/CAM tren nguoi")
        # 10 interior lan street
        if pre in interior and ("shopping street" in pl or "asphalt" in pl): R(sid, "preset interior ma prompt co street/asphalt")
        # 11 style/motion/avoid dong nhat
        _ST, _MO, _MOX, _AV = _prof(prof)
        if _ST not in prompt or _AV not in prompt or not (_MO in prompt or _MOX in prompt):
            R(sid, "STYLE/MOTION/AVOID khong nguyen van")
        # 12 cau cam trong STYLE cu
        if "shot on" in pl or "home movie" in pl: R(sid, "con 'shot on ... film' -> ve dai phim")
    # 13 cast: vat cam/deo phai 'plain unmarked'
    for k, v in C.items():
        vl = v.lower()
        if any(o in vl for o in ("satchel", "bag", "box", "flag", "sign", "bottle", "cap", "hat", "apron", "jacket")):
            if not all(w in vl for w in PLAIN_WORDS):
                W(f"cast:{k}", "vat cam/deo thieu 'plain unmarked' -> model in chu/logo")

    # ---------------------------------------------------------------------------------
    # §11 CHUOI HANH DONG — noi lien canh truoc voi canh sau
    # ---------------------------------------------------------------------------------
    chains = {}
    for i, r in enumerate(SR):
        if r[6]: chains.setdefault(r[6], []).append(i)
    for cid, ii in chains.items():
        sid0 = SR[ii[0]][0]
        # C1: cac canh cua mot chuoi phai LIEN NHAU trong S (user gen theo dung thu tu file FLOW)
        if ii != list(range(ii[0], ii[0] + len(ii))):
            R(sid0, f"chuoi '{cid}' bi chen canh khac vao giua — phai lien nhau trong S")
        # C2: cung chuoi = cung BOI CANH (preset). Doi preset giua chuoi = doi canh, khong con noi lien
        pres = {SR[i][3] for i in ii}
        if len(pres) > 1:
            R(sid0, f"chuoi '{cid}' dung {len(pres)} preset khac nhau: {sorted(pres)}")
        for a, b in zip(ii, ii[1:]):
            sa, sb = SR[a], SR[b]
            # C3: canh truoc PHAI khai 'out' thi canh sau moi noi vao duoc
            if not sa[7]:
                R(sa[0], f"trong chuoi '{cid}' nhung THIEU 'out' (trang thai ket) — canh sau khong noi vao duoc")
            elif len(sa[7]) > 110:
                W(sa[0], f"'out' dai {len(sa[7])} ky — viet ngan (vi tri + tu the + vat), canh sau se mo bang no")
            # C4: cam LAT NGUOC huong giua hai canh lien nhau
            if AWAY_CAM.search(sa[2]) and TOWARD_CAM.search(sb[2]):
                R(sb[0], f"lat nguoc huong ngay sau {sa[0]} (dang di XA roi quay lai DI VE phia camera)")
            # C5: framing khong duoc nhay qua 2 bac trong cung chuoi
            # Trong mot chuoi, doi framing = doi cu may = mat cam giac lien tuc.
            # Khong co Extend thi day la thu duy nhat con giu duoc su lien mach o cho cat.
            if sa[4] != sb[4]:
                W(sb[0], f"doi framing GIUA chuoi '{cid}': {sa[4]} -> {sb[4]} "
                         f"(muon doi cu may thi CAT chuoi, dung 'cut=')")

    # V1 (thay C6 tu 2026-09-07): HAI CANH RONG LIEN TIEP trong cung boi canh.
    #   Do thuc te: model KHONG giu duoc can phong qua hai lan gen. Hai canh RONG lien tiep
    #   => mat CHO no khop => thay dut. Chen mot canh CHAT vao giua thi doi phong khong ai biet.
    for a, b in zip(SR, SR[1:]):
        if (a[1] == b[1] and a[3] == b[3]
                and a[4] in WIDE_FRAMINGS and b[4] in WIDE_FRAMINGS):
            (R if chain_strict else W)(
                b[0], f"hai canh RONG lien tiep ({a[0]}:{a[4]} -> {b[0]}:{b[4]}) cung boi canh — "
                      f"mat se CHO chung khop ma model khong giu duoc phong. Chen mot canh CHAT "
                      f"({'/'.join(sorted(TIGHT_FRAMINGS))}) vao giua")

    # C7: moi KHOI phai mo bang nhip DEN NOI — nhan vat DI TOI cho do, khong dung san.
    #     Day la mo lien ket giua hai khoi: khong co no thi du trong khoi co noi lien,
    #     nguoi xem van thay bai la mot chuoi tieu muc roi rac (benh cua kich ban dang muc).
    _first = {}
    for r in SR:
        _first.setdefault(r[1], r)
    for blk, r in _first.items():
        if blk in ("HOOK", "END"):
            continue                       # mo/dong bai co luat rieng
        if not MOVE_VERBS.search(SUBJ_AMBIENT.sub(" ", r[2].lower())):
            W(r[0], f"khoi '{blk}' mo bang canh DUNG SAN — nen mo bang nhip DEN NOI "
                    f"(nhan vat di toi tu cho truoc), xem §8.6")

    # ---------------------------------------------------------------------------------
    # §12 CAST LOCK — it nhan vat, va nhan vat tai xuat hien thi phai GIAU MAT
    # ---------------------------------------------------------------------------------
    seen = collections.Counter()
    for r in SR:
        toks = set(CAST_TOKEN.findall(r[2]))
        seen.update(toks)
        if len(toks) > MAX_CAST_IN_SCENE:
            W(r[0], f"{len(toks)} nhan vat trong MOT canh ({sorted(toks)}) — moi nguoi them la mot truc sai lech")
    if len(seen) > MAX_CAST_IN_VIDEO:
        W(SR[0][0], f"video dung {len(seen)} nhan vat co ten ({sorted(seen)}) — tran de giu dong nhat la {MAX_CAST_IN_VIDEO}")
    for tok, n in seen.items():
        if n < 2: continue
        ho = [r for r in SR if f"A_{tok}" in r[2]
              and r[4] not in FACE_HIDDEN and not HIDE_WORDS.search(r[2])]
        if ho:
            W(ho[0][0], f"A_{tok} xuat hien {n} clip nhung {len(ho)} clip THAY MAT "
                        f"({', '.join(x[0] for x in ho[:4])}) — t2v khong khoa duoc mat, hay giau mat")

    # ---------------------------------------------------------------------------------
    # §3.5 DAM DONG — solo o NOI CONG CONG phai co ly do (loi ke goi nhung cho nay la dong)
    # ---------------------------------------------------------------------------------
    _lv = collections.Counter()
    _solo_public = []
    for _r in S:
        _pre = _r[3]
        _, _lvl, _why = _extras(_pre, _crowd_of(_r, crowd), _r[2])
        _lv[_lvl] += 1
        if _lvl == "solo" and _pre in PUBLIC_PRESETS:
            (_solo_public.append((_r[0], _pre, _why)))
    for _sid, _pre, _why in _solo_public:
        if not _why:
            R(_sid, f"SOLO o noi cong cong '{_pre}' ma khong khai ly do — dat "
                    f"crowd=('solo','<vi sao>') hoac doi sang 'few'/'full'")
    _n = max(1, len(S))
    _solo_pct = _lv["solo"] * 100 // _n

    _ared, _awarn, _ac = act_report(S, C, quiet=True)
    for _m in _ared:  R(SR[0][0], "HO DONG TAC: " + _m)
    for _m in _awarn: W(SR[0][0], "HO DONG TAC: " + _m)

    _lk, _cd, _pc = linkage(S)
    if not quiet:
        act_report(S, C)
        print(f"{'dam dong':20}: full {_lv['full']} · few {_lv['few']} · solo {_lv['solo']} "
              f"({_solo_pct}% solo)")
        print(f"{'do AN TOAN moi noi':20}: {_lk}/{_cd} cap da noi ({_pc:.0f}%)  "
              f"[muc tieu >=70% — xem 04_VIDEOGEN_PROMPTS.md §8.6]")
        print("SO PROMPT           :", len(rows))
        print("do dai prompt       : min", min(len(r[5]) for r in rows), "max", max(len(r[5]) for r in rows))
        print("tier                :", dict(collections.Counter(r[3] for r in rows)))
        print("khoi                :", dict(collections.Counter(r[1] for r in rows)))
        print("preset dung         :", len(set(r[2] for r in rows)), "/", len(P))
        for k in sorted(wl): print(f"   i ngoai le khong nguoi [{k}]: {wl[k]}")
        if warn:
            print(f"⚠️  CANH BAO ({len(warn)}):")
            for s, w in warn: print(f"   {s:6} {w}")
        if red:
            print(f"🔴 LOI ({len(red)}) — CHAN:")
            for s, w in red: print(f"   {s:6} {w}")
        else:
            print("✅ GATE SACH")
    return len(red), len(warn)


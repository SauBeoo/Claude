    """Thay token A_XXX -> mo ta cast. Token = 'A_' + ten khoa viet hoa (A_ME, A_HAHA, AN_ATTENDANT...)."""
    # 🔴 PHAI thay token DAI TRUOC: dict order lam 'A_KO' an truoc 'A_KO2'/'A_KORI'
    #    -> ra rac 'barefoot2' / 'barefootRI' (7 dong cua video 12, bat 2026-09-11).
    for k in sorted(C, key=len, reverse=True):
        v = C[k]
        for tok in (f"A_{k.upper()}", f"AN_{k.upper()}"):
            act = act.replace(tok, v)
    return act

def _framing(cam):
    return FRAMINGS.get(cam, cam)

# HO SO KENH (2026-09-06). Kenh nenkin dung cung cong thuc nhung KHAC ba khoi: STYLE
# (Nhat HIEN DAI, khong phim 8mm) va AVOID (khong co dai phim, nhung phai cam DICH DANH
# chu tren giay + doi trang thai vat/kinh — hai thu lam hong 4/6 clip cua nenkin v21).
# Truyen `prof`; khong truyen => nguyen showa, khong video cu nao phai gen lai.
def _prof(prof):
    if not prof:
        return STYLE, MOTION, MOTION_EXIT, AVOID
    return (prof.get("STYLE", STYLE), prof.get("MOTION", MOTION),
            prof.get("MOTION_EXIT", MOTION_EXIT), prof.get("AVOID", AVOID))


def build(S, P, C, prof=None, plates=None, crowd=None):
    """S: list (sid, blk, act, preset, framing_key_or_str, tier[, chain, out, crowd]).
    crowd: dict preset -> 'solo'|'few'|'full'|('solo','ly do'). -> rows (sid,blk,preset,tier,cam,prompt)."""
    ST, MO, MOX, AV = _prof(prof)
    rows = []
    prev_chain, prev_out = None, None
    for _row in S:
        sid, blk, act, preset, cam, tier, chain, out = _srow(_row)
        # NOI LIEN: canh khong phai dau chuoi thi MO bang TRANG THAI KET cua canh truoc
        _in_chain = bool(chain and chain == prev_chain and prev_out)
        if _in_chain and USE_CHAIN_LOCK:
            act = CONT_LEAD.format(out=short_ref(prev_out, C)) + act
        prev_chain, prev_out = chain, (out if chain else None)
        _ptok, _ = plate_for(act, plates)
        act_x = expand_with_plate(act, C, _ptok) if _ptok else expand(act, C)
        camx  = _framing(cam)
        motion = MOX if any(w in act_x.lower() for w in EXIT_WORDS) else MO
        # framing co CAM DI CHUYEN thi phai bo cau "camera holds one position" (xem MOTION_MOVE)
        if cam in MOVING_CAMS:
            motion = MOTION_MOVE
            if any(w in act_x.lower() for w in EXIT_WORDS):
                motion = motion.replace(", the subject remains in frame for the whole shot", "")
        elif cam in POV_CAMS:
            motion = {"pov_walk": MOTION_POV_WALK,
                      "pov_bike": MOTION_POV_BIKE}.get(cam, MOTION_POV)
            # ACT bao "tien len mot buoc" ma MOTION_POV cam tinh tien => phai doi MOTION,
            # khong phai doi cau van (xem MOTION_POV_STEP).
            if cam not in ("pov_walk", "pov_bike") and STEP_RE.search(act_x):
                motion = MOTION_POV_STEP
        _lock = f", {CHAIN_LOCK}" if (_in_chain and USE_CHAIN_LOCK) else ""
        ex, _lvl, _ = _extras(preset, _crowd_of(_row, crowd), act_x)
        place = f"{P[preset]}, {ex}" if ex else P[preset]
        _ima = preset.startswith("ima_")          # canh so sanh thoi nay
        _ST, _AVx = (STYLE_MODERN, AVOID_MODERN) if _ima else (ST, AV)
        ST_x = _style_pov(_ST) if cam in POV_CAMS else _ST
        # 🔴 2026-09-12: canh muc SOLO la canh CO Y chi co mot nguoi (gieng sau nha, bep,
        #   duoi mai hien...). De nguyen 2 cau nay thi prompt tu cai nhau — no vua doi
        #   "doi song o nhieu cu ly" vua cam "mot nguyen mot minh tren san trong".
        #   Dinh 31/165 prompt truoc khi va.
        if _lvl == "solo":
            ST_x, _AVx = solo_style(ST_x), solo_avoid(_AVx)
        # co ti le dat o CUOI prompt. ⚠️ `--ar` da do duoc la BI BO QUA o tool gen ANH
        #   (media-library.md §2.10 ①: xin 16:10/5:4/16:9 -> 18/18 anh van ra 1376x768).
        #   Chua do tren Flow VIDEO; them vao vo hai, nhung DUNG coi no la bao dam —
        #   cai that su ganh ti le la cau chu trong STYLE.
        # ⭐ 2026-09-12 (user bat): POV KHONG duoc ghep nhu moi canh khac.
        #   Cach cu dat act_x LEN DAU, ma act_x mo bang ca doan ta cast ("a small figure in a
        #   plain white cotton undershirt...") => prompt mo bang MOT NGUOI NHIN TU NGOAI, va
        #   cau khai bao POV mai sau ACT moi toi. Model dung xong bo cuc goc 3 roi.
        #   Sua: khai bao POV len TRUOC, va cast doi vai tu CHU NGU thanh "nhin qua mat cua".
        #   Quy uoc viet ACT cho POV: mo bang "A_XXX: " roi ta CAI MINH THAY, khong ta minh.
        if cam in POV_CAMS:
            _m = re.match(r"\s*(A_[A-Z0-9]+)\s*:\s*", act)
            if _m:
                _k = _m.group(1)[2:].lower()
                # 🔴 KHONG dung mo ta cast thuong: no ta quan ao/chan tay NHIN TU NGOAI
                #   ("a small figure in a plain white cotton undershirt... barefoot") va chinh
                #   cau do keo model ve goc 3. Ban "<ten>_pov" ta DUNG PHAN minh tu nhin thay.
                _desc = (C.get(_k + "_" + cam) or C.get(_k + "_pov")
                         or C.get(_k, "the person"))
                act_x = expand(act[_m.end():], C)
                camx = ("a first-person shot: the camera IS their own eyes and nothing else, "
                        "the whole scene is only ever seen out of that one head and never "
                        "from outside it, " + POV_BODY[cam] + " — " + _desc +
                        " — and nothing of them is ever seen from the outside")
            # loc vo danh + danh sach cam deu phai bo cac cau coi camera la vat the ben ngoai
            place = place.replace(EXTRA_LOCK, EXTRA_LOCK_POV)
            if not _ima:
                _AVx = AVOID_POV
            prompt = f"{camx}, {act_x}, {place}, {ST_x}, {motion}{_lock}. {_AVx}. --ar 16:9"
        else:
            prompt = f"{act_x}, {camx}, {place}, {ST_x}, {motion}{_lock}. {_AVx}. --ar 16:9"
        rows.append((sid, blk, preset, tier, camx, prompt))
    return rows


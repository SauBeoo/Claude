# -*- coding: utf-8 -*-
r"""grade_showa — LOP MAU PHIM CU cho clip t2v (user chot 2026-09-17: "mau phim hoai co hon").

VI SAO GRADE O HAU KY, KHONG PHAI O PROMPT:
  prompt dieu khien duoc VI TRI va NOI DUNG, nhung KHONG dieu khien duoc mau chinh xac
  (`media-library.md` §2.10 ⑥ — model nghe vi tri, khong nghe ti le). De model tu lo mau thi
  176 clip ra 176 tong khac nhau => video loang lo. Grade bang ffmpeg ap DEU cho ca lo,
  sua lai khong ton credit gen, va chinh duoc SAU KHI da nhin thay clip that.
  ⇒ STYLE trong prompt chi lam MOT viec: giu model khoi gen ra mau qua ruc/qua net
    (grade khong cuu duoc anh da bao hoa chay). Phan con lai la viec cua tool nay.

MUC TIEU = SO DO, khong phai cam giac. Chuan doi chieu la phim tu lieu THAT
(`measure_filmlook.py`, Japan Today 1959): luma 66 · contrast 50 · sat 62 · grain 17,8 · den 14,7%.

  py tools/grade_showa.py <clip|folder> --out <folder> [--preset showa70|showa70_soft]
  py tools/grade_showa.py <clip> --compare          # xuat anh TRUOC/SAU de duyet mat
  py tools/grade_showa.py <clip> --measure          # in so truoc/sau + khoang cach toi phim that
"""
import argparse, io, os, subprocess, sys, glob

sys.stdout.reconfigure(encoding="utf-8", errors="replace")
sys.stderr.reconfigure(encoding="utf-8", errors="replace")

# --------------------------------------------------------------------------------------
# PRESET — moi khoi mot viec, de con biet tat cai nao khi qua tay
# --------------------------------------------------------------------------------------
PRESETS = {
 # ⭐ mac dinh: keo AI ve phia phim Fujicolor da bac mau
 "showa70": (
    # 🔴 VONG 1 CUA PRESET NAY DA SAI 2 CHO, do bang may moi thay — ghi lai de khong lap:
    #   a. `colorbalance` manh (rs/rm/rh duong + bs/bm/bh am) lam sat HSV TANG 75,6 -> 90,1
    #      trong khi muc tieu la GIAM ve 62,4. Am vang manh = bao hoa CAO theo phep do.
    #      => am mau phai NHE, viec ha bao hoa giao han cho `eq=saturation`.
    #   b. `noise` dat TRUOC `unsharp` lam mem => hat bi xoa: grain 19,86 -> 11,25 (muc tieu 17,8).
    #      => `noise` phai la khoi CUOI CUNG cua chain.
    # 1. crush BONG + ha TRANG: phim tu lieu that co 14,7% pixel den bet, khong milky
    "curves=all='0/0 0.05/0.030 0.5/0.47 1/0.94',"
    # 2. am mau NHE (chi trung gian + vung sang), khong dung o bong
    "colorbalance=rm=0.030:bm=-0.030:rh=0.020:bh=-0.035,"
    # 3. keo bao hoa xuong muc phim that, GIU tuong phan (muc tieu contrast ~50)
    "eq=saturation=0.70:contrast=1.02:gamma=1.00:brightness=-0.008,"
    # 4. halation: quang am quanh nguon sang — thu lam anh "co chat phim" nhat
    "split[a][hl];[hl]gblur=sigma=16,curves=all='0/0 0.62/0 0.85/0.5 1/1'[g];"
    "[a][g]blend=all_mode=screen:all_opacity=0.12,"
    # 5. lam mem net digital + vignette
    "unsharp=5:5:-0.25:5:5:0,vignette=PI/4.2,"
    # 6. HAT — phai dung CUOI, neu khong bi khoi lam mem o tren xoa mat
    "noise=alls=16:allf=t+u"
 ),
 # ban NHE hon — giu sang hon, it vignette. Dung cho canh trong nha da toi san.
 "showa70_soft": (
    "curves=all='0/0 0.05/0.035 0.5/0.49 1/0.96',"
    "colorbalance=rm=0.022:bm=-0.022:rh=0.015:bh=-0.025,"
    "eq=saturation=0.80:contrast=1.01:gamma=1.01,"
    "split[a][hl];[hl]gblur=sigma=14,curves=all='0/0 0.66/0 0.88/0.45 1/1'[g];"
    "[a][g]blend=all_mode=screen:all_opacity=0.08,"
    "unsharp=5:5:-0.15:5:5:0,vignette=PI/5.5,noise=alls=11:allf=t+u"
 ),
 # ban DAM — bac mau ro, am vang-luc, hat day. Gan phim tu lieu nhat, nhung an chi tiet vung toi.
 "showa70_deep": (
    "curves=all='0/0 0.06/0.022 0.5/0.45 1/0.90',"
    "colorbalance=rm=0.045:gm=0.020:bm=-0.045:rh=0.030:bh=-0.050:gs=0.015:bs=-0.020,"
    "eq=saturation=0.60:contrast=1.04:gamma=0.99:brightness=-0.012,"
    "split[a][hl];[hl]gblur=sigma=20,curves=all='0/0 0.58/0 0.82/0.55 1/1'[g];"
    "[a][g]blend=all_mode=screen:all_opacity=0.18,"
    "unsharp=5:5:-0.35:5:5:0,vignette=PI/3.8,noise=alls=20:allf=t+u"
 ),
}


def run(cmd):
    r = subprocess.run(cmd, capture_output=True)
    if r.returncode:
        sys.stderr.write(r.stderr.decode("utf-8", "replace")[-800:] + "\n")
    return r.returncode


def grade_one(src, dst, preset):
    return run(["ffmpeg", "-v", "error", "-y", "-i", src, "-filter_complex", PRESETS[preset],
                "-c:v", "libx264", "-preset", "veryfast", "-crf", "18",
                "-pix_fmt", "yuv420p", "-an", dst])


def cmd_compare(src, preset, at=3.0):
    """Ghep frame TRUOC | SAU canh nhau — duyet bang mat truoc khi ap ca lo."""
    out = os.path.join(os.path.dirname(src) or ".", "_grade_compare")
    os.makedirs(out, exist_ok=True)
    base = os.path.splitext(os.path.basename(src))[0]
    a = os.path.join(out, base + "_A_truoc.png")
    b = os.path.join(out, base + "_B_sau.png")
    run(["ffmpeg", "-v", "error", "-y", "-ss", str(at), "-i", src, "-frames:v", "1", a])
    run(["ffmpeg", "-v", "error", "-y", "-ss", str(at), "-i", src, "-frames:v", "1",
         "-filter_complex", PRESETS[preset], b])
    sh = os.path.join(out, base + "_%s.png" % preset)
    rc = run(["ffmpeg", "-v", "error", "-y", "-i", a, "-i", b, "-filter_complex",
         "[0:v]scale=760:-1[l];[1:v]scale=760:-1[r];[l][r]hstack", sh])
    print(("  TRUOC | SAU  -> " + sh) if rc == 0 and os.path.exists(sh)
          else "  !! ghep that bai (ffmpeg): " + sh)
    return sh


def cmd_measure(src, preset):
    """In so truoc/sau + khoang cach toi PHIM THAT (chuan cua measure_filmlook)."""
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import importlib.util
    spec = importlib.util.spec_from_file_location(
        "mfl", os.path.join(os.path.dirname(os.path.abspath(__file__)), "measure_filmlook.py"))
    mfl = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(mfl)            # no tu in bang tham chieu
    except Exception:
        pass
    tmp = os.path.splitext(src)[0] + "_graded_tmp.mp4"
    grade_one(src, tmp, preset)
    REF = dict(luma=66.3, contrast=50.1, sat=62.4, grain=17.76, clip_lo=14.7)
    print("\n%-14s %6s %9s %6s %7s %7s" % ("", "luma", "contrast", "sat", "grain", "den%"))
    for lab, p in (("TRUOC", src), ("SAU  ", tmp)):
        st = mfl.stats(mfl.frames(p, [1, 3, 5]))
        print("%-14s %6.1f %9.1f %6.1f %7.2f %6.1f%%"
              % (lab, st["luma"], st["contrast"], st["sat"], st["grain"], st["clip_lo"]))
    print("%-14s %6.1f %9.1f %6.1f %7.2f %6.1f%%   <- phim tu lieu THAT 1959"
          % ("MUC TIEU", REF["luma"], REF["contrast"], REF["sat"], REF["grain"], REF["clip_lo"]))
    os.remove(tmp)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("src")
    ap.add_argument("--out")
    ap.add_argument("--preset", default="showa70", choices=sorted(PRESETS))
    ap.add_argument("--compare", action="store_true")
    ap.add_argument("--measure", action="store_true")
    ap.add_argument("--at", type=float, default=3.0)
    ap.add_argument("--exclude", default=None,
                    help="chuoi trong TEN FILE thi BO QUA (chi copy nguyen). "
                         "🔴 Dung cho canh THOI NAY: videogen_lib da cho chung STYLE_MODERN rieng "
                         "(sach, net), grade mau phim cu len la XOA MAT doi lap xua/nay — thu "
                         "chinh la co che cua bai nay (cuon so cu trong tay nguoi thoi nay).")
    a = ap.parse_args()

    if a.compare:
        cmd_compare(a.src, a.preset, a.at); return
    if a.measure:
        cmd_measure(a.src, a.preset); return

    files = sorted(glob.glob(os.path.join(a.src, "*.mp4"))) if os.path.isdir(a.src) else [a.src]
    if not a.out:
        sys.exit("!! thieu --out (khong ghi de ban goc — con de so lai)")
    os.makedirs(a.out, exist_ok=True)
    ok = 0
    for i, f in enumerate(files, 1):
        dst = os.path.join(a.out, os.path.basename(f))
        if a.exclude and a.exclude in os.path.basename(f):
            if not os.path.exists(dst) or os.path.getmtime(dst) < os.path.getmtime(f):
                import shutil; shutil.copy2(f, dst)
            print("  [%3d/%d] BO QUA grade (thoi nay): %s" % (i, len(files), os.path.basename(f)))
            ok += 1; continue
        if os.path.exists(dst) and os.path.getmtime(dst) >= os.path.getmtime(f):
            print("  [%3d/%d] da co, bo qua: %s" % (i, len(files), os.path.basename(f))); ok += 1; continue
        if grade_one(f, dst, a.preset) == 0:
            ok += 1
        print("  [%3d/%d] %s" % (i, len(files), os.path.basename(f)))
    print("\nda grade %d/%d clip (preset %s) -> %s" % (ok, len(files), a.preset, a.out))


if __name__ == "__main__":
    main()

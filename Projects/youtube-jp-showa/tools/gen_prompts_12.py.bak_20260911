('G16', 'END', 'A_HAHA stands up from the boards, then walks slowly away from the camera along the veranda past the open doors, then stops at the far corner post while the curtain lifts along the whole length behind her', 'engawa', 'medium', 'Q', None, 'A_HAHA standing at the far corner post of the veranda'),
('G17', 'END', 'A_HAHA stands at the corner post with one hand on it, then turns her head to look back down the empty veranda, then faces out to the garden again while the chime swings and the leaves move', 'engawa', 'wide', 'Q', None, 'A_HAHA standing at the corner post, facing the garden'),
('G18', 'END', 'A_HAHA lifts her hand off the post, then steps down off the boards into the garden, then walks away from the camera down the garden and grows smaller while the open doors stand empty behind her and the curtain lifts', 'engawa', 'medium', 'Q', None, None),
]

# =====================================================================================
# DUNG + GATE + XUAT
# =====================================================================================
OUTDIR = r"E:\Claude\Projects\youtube-jp-showa\06_VIDEO\12_natsu-atarimae"

# `cut` = cho CAT HAN chuoi (doi canh / doi thoi diem trong truyen), khong phai de tranh viet 'out'.
CUT = {
 "H3",          # cold open: tu phong ngu nhay sang gieng — cu soc thu 2, co y cat
 "B2",          # M2 mo bang nhip DEN NOI: di tu bep ra gieng (§8.6c luat 1)
 "C1",          # M3 mo bang nhip DEN NOI: xuong doc toi truong
 "E1",          # M4 mo bang nhip DEN NOI: tu truong ve nha
 "F1",          # M5 mo bang nhip DEN NOI: tu cua truoc vong ra vuon
}
S = autochain(S, cut=CUT)

rows = build(S, P, C, crowd=CROWD)
n_red, n_warn = gate(rows, S, P, C,
                     interior={"zashiki", "daidokoro"},
                     strict=True, crowd=CROWD)
act_report(S, C)
safe, risky, pct = linkage(S)
print("\nNOI AN TOAN: %d/%d moi noi cung boi canh co it nhat mot canh CHAT (%.0f%%)"
      % (safe, risky, pct))

if n_red == 0:
    write_outputs(rows, OUTDIR)
    print("\nXUAT -> %s\\videogen_FLOW.txt | _TENFILE.txt | _BLOCKS.md" % OUTDIR)
else:
    print("\n[CHAN] %d loi do — KHONG xuat file. Sua roi chay lai." % n_red)
sys.exit(1 if n_red else 0)

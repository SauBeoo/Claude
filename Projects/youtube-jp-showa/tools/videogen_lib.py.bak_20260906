# -*- coding: utf-8 -*-
"""videogen_lib — CONG THUC DUY NHAT cho prompt text-to-video (Veo/Flow) cua kenh 昭和くらし図鑑.

Nguon su that ve LUAT: 04_VIDEOGEN_PROMPTS.md. File nay la ban thi hanh — hang so NGUYEN VAN + gate.
gen_prompts.py cua MOI video chi khai bao P (preset boi canh) · C (cast) · S (scene) roi goi:

    from videogen_lib import build, gate, write_outputs
    rows = build(S, P, C)
    gate(rows, S, P, C, whitelist_no_human={...}, strict=True)
    write_outputs(rows, ".")

⛔ KHONG chep STYLE/AVOID/MOTION vao gen_prompts.py — moi bai hoc them vao day thi lan sang moi video.

Vi sao ton tai (video 10, 2026-09-06, soi 121/121 clip): 17 loi nang + 15 nhe + 120/120 khung phim.
Moi loi truy ve MOT cau trong prompt:
  khung phim + chu FUJI     <- "shot on 8mm home movie film"          -> STYLE v2 + AVOID dich danh
  tay/chan cut lo lung      <- framing "hands only"/"feet only"        -> CAM framing khong co than
  vat bien hinh             <- nhieu vat doi tay / mo ta khong nguyen van -> 1 vat 1 hanh dong, "the same X throughout"
  dao chieu, quay mat lai   <- dong tu di chuyen khong co huong camera -> bat buoc huong + AVOID reversing
  chu Latin tren vat        <- "no readable text" quá chung             -> "plain unmarked", AVOID letters on any object
  mat chu the giua clip     <- khong co "remains in frame"              -> MOTION v2
  nguoi gap/bien dang       <- tu the phuc tap (leans out of a window)  -> gate tu the cam
  do                        <- khong co chuyen dong phu                 -> gate secondary motion
"""
import io, os, re, sys, collections
sys.stdout.reconfigure(encoding="utf-8", errors="replace")

# =====================================================================================
# §2 STYLE LOCK v2 — NGUYEN VAN. Bo "shot on 8mm home movie film" (model ve DAI PHIM),
#    giu CHAT phim (mau/hat/mem) va ep anh phu kin khung.
# =====================================================================================
STYLE = ("1970s Japan (Showa era, around 1970), the color, grain and softness of 1970s 8mm film, "
         "faded warm Fujicolor palette, soft natural light, slight vignette, "
         "nostalgic documentary photography, muted greens and ochres, natural imperfect framing, "
         "the image fills the entire frame edge to edge, 16:9")

# =====================================================================================
# §4 MOTION RULES v2 — NGUYEN VAN. Bien the EXIT dung khi canh CO Y cho nguoi di ra khoi khung.
# =====================================================================================
MOTION      = ("slow deliberate natural human motion, continuous single take, no cuts, "
               "the subject remains in frame for the whole shot, no reversing")
MOTION_EXIT = ("slow deliberate natural human motion, continuous single take, no cuts, no reversing")
EXIT_WORDS  = ("out of frame", "out of sight", "leaves the frame", "disappears", "walks off", "is gone")

# =====================================================================================
# §5 NEGATIVE v2 — NGUYEN VAN. 4 nhom moi so voi v1: khung phim · dao chieu · chu tren vat · tay roi/vat bien hinh.
# =====================================================================================
AVOID = ("Avoid: film strip border, sprocket holes, film edge markings, any frame or border around the image, "
         "modern objects, smartphones, LED lights, plastic bottles, air conditioner, modern clothing, "
         "sneakers with logos, any letters, words, numbers or logos on any object, bag, sign or box, "
         "brand logos, western faces, anime style, oversaturated colors, HDR look, clean digital sharpness, "
         "close-up faces, fast cuts, camera shake, reversing motion, walking backwards, "
         "turning to face the camera, disembodied hands, floating limbs, extra fingers, "
         "morphing objects, objects changing shape or color")

# =====================================================================================
# §3 FRAMING — danh sach DONG. Khoa -> chuoi nguyen van. Moi framing deu co THAN NGUOI trong khung.
# Scene co the ghi KHOA (khuyen dung) hoac chuoi tu do (se bi gate soi ky hon).
# =====================================================================================
FRAMINGS = {
 "wide":    "static wide shot at chest height, the whole figure in frame",
 "medium":  "static medium shot at chest height, torso and hands in frame, face out of frame",
 "ots":     "over the shoulder, torso and hands in frame, face out of frame",
 "behind":  "seen from behind at chest height, the whole figure in frame",
 "low":     "static low angle at knee height, legs and body in frame",
 "high":    "static high angle looking down, the figure and the ground in frame",
 "pan":     "slow pan at chest height, the whole figure in frame",
 "tilt":    "slow tilt up from the base, the figure at the foot in frame",
 "still":   "static wide shot, no people",            # chi cho canh WHITELIST khong nguoi
}
# framing CAM — dung nguoi la 🔴 (14/21 clip hands-only cua video 10 hong).
# Luat don gian de khong lot: framing NHAC toi tay/chan ma KHONG nhac toi than => cam.
# (regex liet ke mau cu bo sot '14b hands and coin slot' va '08 planks and feet' trong selftest.)
LIMB_WORDS = re.compile(r"\b(hands?|feet|foot|legs?|fingers?|arms?)\b|close[- ]?up|macro", re.I)
BODY_WORDS = re.compile(r"torso|whole figure|the figure|body|figures|shoulder|legs and body", re.I)
def bad_framing(cam):
    cl = cam.lower()
    return bool(LIMB_WORDS.search(cl)) and not BODY_WORDS.search(cl)

# =====================================================================================
# GATE — cac danh sach tu
# =====================================================================================
CHILD_WORDS = [" child", " children", " kid", " kids", " boy", " girl", " elementary", "toddler", "infant", "schoolchild", "pupil"]
HUMAN_WORDS = ["hand", "woman", "man ", "figure", "figures", "family", "people", "passer", "workman", "workmen",
               "shopkeeper", "cyclist", "someone", "owner", "group", "feet", "foot", "shoes", "caps", "satchel",
               "traffic", "student", "students", "adult", "worker", "attendant", "waitress", "cook", "grandmother"]
# chi dong tu DI CHUYEN XUYEN KHUNG (H1 hong vi 'walks' khong co huong). 'steps aside', 'passes behind'
# khong can huong -> khong liet ke, tranh 62/121 canh bi 🔴 oan (selftest lan 1).
MOVE_VERBS  = re.compile(r"\b(walk|walks|walking|run|runs|running|cross|crosses|crossing|march|marches|"
                         r"file|files|wander|wanders|stroll|strolls|approach|approaches|"
                         r"hurr|hurries|dash|dashes|jog|jogs|round|rounds|cycles?|pedals?)\b|"
                         r"\bheads?\s+(?:toward|for|back|off|out|down|up|into|straight)\b", re.I)
# 🔴 2026-09-06 (lo 54 prompt nenkin) — hai bao oan cua MOVE_VERBS, cung ho voi ca "drift" da va o v2:
#  ① "head" la BO PHAN CO THE. "tilts his head" · "shakes his head" · "her head tilted" bi bat oan
#     4/54 shot. Dong tu di chuyen thuc su la "heads TOWARD/FOR/BACK/...".
#  ② CHU NGU LA BONG/ANH SANG/BUI thi dong tu di chuyen la CHUYEN DONG PHU, khong phai nguoi di,
#     nen khong can huong camera: "the shadow CROSSES his arm" bi bat oan.
SUBJ_AMBIENT = re.compile(r"\b(shadow|shadows|light|dust|steam|smoke|breeze|wind|curtain|air|"
                          r"reflection|sunlight|daylight)\b[^,.]{0,28}?\b(?:cross\w*|move\w*|"
                          r"travel\w*|creep\w*|slid\w*|run\w*|pass\w*)\b", re.I)
# ('drift' bo khoi MOVE_VERBS: 'dust drifts' la chuyen dong PHU, bat oan canh 24)
DIRECTION   = re.compile(r"toward the camera|away from the camera|left to right|right to left|across the frame|"
                         r"past the camera|into (?:the )?frame|out of (?:the )?frame|out of sight|"
                         r"from the far end|to the far end|down the lane|up the lane|deeper into|"
                         r"getting smaller|growing smaller|growing larger|from behind|in place|on the spot", re.I)
SECONDARY   = re.compile(r"breeze|wind|sway|swings|swinging|flutter|ripple|dust|steam|smoke|shadow|shadows|"
                         r"shifts (?:his|her|its)? ?weight|weight shift|drips|dripping|drops|bounc|rustl|flap|stirring|"
                         r"catch(?:es|ing) the light|light (?:moves|spreading|spreads)|glint|curtain|hair|cloth|"
                         r"sleeve|hem|leaves|grass|awning|drift", re.I)
BAD_POSE    = re.compile(r"leans? out of|bends? double|contort|upside down|hangs? from|lean(?:s|ing)? far out|"
                         r"twists? around|spins?|somersault|jumps? over the camera", re.I)
FACE_CAM    = re.compile(r"looks? (?:straight )?(?:at|into) the camera|faces? the camera|turns? to (?:face|look at) the camera|"
                         r"smiles? at the camera|eye contact", re.I)
POSSESSIVE  = re.compile(r"A_[A-Z]+'s")
PLAIN_WORDS = ("plain", "unmarked")

# =====================================================================================
# BUILD
# =====================================================================================
def expand(act, C):
    """Thay token A_XXX -> mo ta cast. Token = 'A_' + ten khoa viet hoa (A_ME, A_HAHA, AN_ATTENDANT...)."""
    for k, v in C.items():
        for tok in (f"A_{k.upper()}", f"AN_{k.upper()}"):
            act = act.replace(tok, v)
    return act

def _framing(cam):
    return FRAMINGS.get(cam, cam)

# HO SO KENH (2026-09-06). Kenh nenkin dung cung cong thuc nhung KHAC ba khoi: STYLE
# (Nhat HIEN DAI, khong phim 8mm) va AVOID (khong co dai phim, nhung phai cam DICH DANH
# chu tren giay + doi trang thai vat/kinh — hai thu lam hong 4/6 clip cua nenkin v21).
# Truyen `prof`; khong truyen => nguyen showa, khong video cu nao phai gen lai.
def _prof(prof):
    if not prof:
        return STYLE, MOTION, MOTION_EXIT, AVOID
    return (prof.get("STYLE", STYLE), prof.get("MOTION", MOTION),
            prof.get("MOTION_EXIT", MOTION_EXIT), prof.get("AVOID", AVOID))


def build(S, P, C, prof=None):
    """S: list (sid, blk, act, preset, framing_key_or_str, tier). -> rows (sid, blk, preset, tier, cam, prompt)."""
    ST, MO, MOX, AV = _prof(prof)
    rows = []
    for sid, blk, act, preset, cam, tier in S:
        act_x = expand(act, C)
        camx  = _framing(cam)
        motion = MOX if any(w in act_x.lower() for w in EXIT_WORDS) else MO
        prompt = f"{act_x}, {camx}, {P[preset]}, {ST}, {motion}. {AV}."
        rows.append((sid, blk, preset, tier, camx, prompt))
    return rows

# =====================================================================================
# GATE
# =====================================================================================
def gate(rows, S, P, C, whitelist_no_human=None, interior=None, strict=True, quiet=False, prof=None):
    """In bang + return (n_red, n_warn). strict=True: 3 nhip + chuyen dong phu la 🔴 (video moi);
    strict=False: chi ⚠️ (video da gen, chi vá clip loi)."""
    wl = whitelist_no_human or {}
    interior = interior or set()
    acts = {s[0]: s[2] for s in S}
    cams = {s[0]: s[4] for s in S}
    red, warn = [], []
    def R(sid, why): red.append((sid, why))
    def W(sid, why): warn.append((sid, why))

    ids = [r[0] for r in rows]
    for k, v in collections.Counter(ids).items():
        if v > 1: R(k, f"id trung {v} lan")

    for sid, blk, pre, tier, cam, prompt in rows:
        act = acts[sid]; al = act.lower(); pl = prompt.lower(); cl = cam.lower()
        # 1 so huu cach tren token cast
        if POSSESSIVE.search(act): R(sid, "A_XXX's -> expand hong ngu phap")
        # 2 filter tre em
        if any(w in pl for w in CHILD_WORDS): R(sid, "tu tre em (filter Veo)")
        # 3 framing cam / khong co than
        if bad_framing(cl):
            R(sid, f"framing KHONG CO THAN: '{cam[:40]}'")
        elif cams[sid] not in FRAMINGS and not BODY_WORDS.search(cl) and "no people" not in cl:
            W(sid, f"framing tu do, khong neu than nguoi: '{cam[:40]}'")
        # 4 khong co nguoi
        has_human = any(w in pl for w in HUMAN_WORDS)
        if not has_human and sid not in wl: R(sid, "KHONG co nguoi/tay (khong whitelist)")
        # 5 di chuyen ma khong co huong camera
        al_h = SUBJ_AMBIENT.sub(" ", al)      # bo cum chuyen dong PHU truoc khi do
        if MOVE_VERBS.search(al_h) and not DIRECTION.search(al):
            (R if strict else W)(sid, "di chuyen khong co HUONG tuong doi camera (H1 quay mat lai vi thieu cai nay)")
        # 6 nhin/quay ve camera
        if FACE_CAM.search(al): R(sid, "nhin/quay ve camera")
        # 7 tu the cam
        if BAD_POSE.search(al): R(sid, "tu the phuc tap (leans out/bends double/...)")
        # 8 ba nhip
        n_then = al.count(", then ")
        if n_then == 0: R(sid, "0 'then' — mot nhip = canh do")
        elif n_then == 1: (R if strict else W)(sid, "chi 1 'then' — can 2 (3 nhip)")
        # 9 chuyen dong phu (co hon)
        if has_human and not SECONDARY.search(al): (R if strict else W)(sid, "khong co chuyen dong PHU (breeze/sway/dust/shadow/weight)")
        # 10 interior lan street
        if pre in interior and ("shopping street" in pl or "asphalt" in pl): R(sid, "preset interior ma prompt co street/asphalt")
        # 11 style/motion/avoid dong nhat
        _ST, _MO, _MOX, _AV = _prof(prof)
        if _ST not in prompt or _AV not in prompt or not (_MO in prompt or _MOX in prompt):
            R(sid, "STYLE/MOTION/AVOID khong nguyen van")
        # 12 cau cam trong STYLE cu
        if "shot on" in pl or "home movie" in pl: R(sid, "con 'shot on ... film' -> ve dai phim")
    # 13 cast: vat cam/deo phai 'plain unmarked'
    for k, v in C.items():
        vl = v.lower()
        if any(o in vl for o in ("satchel", "bag", "box", "flag", "sign", "bottle", "cap", "hat", "apron", "jacket")):
            if not all(w in vl for w in PLAIN_WORDS):
                W(f"cast:{k}", "vat cam/deo thieu 'plain unmarked' -> model in chu/logo")

    if not quiet:
        print("SO PROMPT           :", len(rows))
        print("do dai prompt       : min", min(len(r[5]) for r in rows), "max", max(len(r[5]) for r in rows))
        print("tier                :", dict(collections.Counter(r[3] for r in rows)))
        print("khoi                :", dict(collections.Counter(r[1] for r in rows)))
        print("preset dung         :", len(set(r[2] for r in rows)), "/", len(P))
        for k in sorted(wl): print(f"   i ngoai le khong nguoi [{k}]: {wl[k]}")
        if warn:
            print(f"⚠️  CANH BAO ({len(warn)}):")
            for s, w in warn: print(f"   {s:6} {w}")
        if red:
            print(f"🔴 LOI ({len(red)}) — CHAN:")
            for s, w in red: print(f"   {s:6} {w}")
        else:
            print("✅ GATE SACH")
    return len(red), len(warn)

# =====================================================================================
# OUTPUT
# =====================================================================================
def write_outputs(rows, outdir=".", prefix="videogen", only=None, prof=None):
    """FLOW.txt (1 prompt/1 dong, bom extension) · TENFILE.txt (thu tu <-> ten clip) · BLOCKS.md (nguoi doc)."""
    sel = [r for r in rows if (only is None or r[0] in only)]
    os.makedirs(outdir, exist_ok=True)
    with io.open(os.path.join(outdir, f"{prefix}_FLOW.txt"), "w", encoding="utf-8") as f:
        for r in sel: f.write(r[5] + "\n")
    with io.open(os.path.join(outdir, f"{prefix}_TENFILE.txt"), "w", encoding="utf-8") as f:
        f.write("# dong FLOW.txt  ->  ten file clip  (thu tu PHAI khop)\n")
        for i, r in enumerate(sel, 1):
            f.write(f"{i:>3}  clip_{r[0]}_{r[1].lower()}_{r[2]}.mp4   [{r[3]}]\n")
    with io.open(os.path.join(outdir, f"{prefix}_BLOCKS.md"), "w", encoding="utf-8") as f:
        f.write(f"# {prefix} — ban nguoi doc (6 khoi, thu tu co dinh)\n\n")
        _ST, _MO, _MOX, _AV = _prof(prof)
        f.write("STYLE: " + _ST + "\n\nMOTION: " + _MO + "\n\nAVOID: " + _AV + "\n\n---\n\n")
        for i, r in enumerate(sel, 1):
            act = r[5].split(", " + r[4])[0]
            f.write(f"## {i}. {r[0]} [{r[1]} · {r[2]} · {r[3]}]\n\nACT: {act}\n\nFRAMING: {r[4]}\n\n")
    print(f"da ghi {prefix}_FLOW.txt ({len(sel)} dong) · {prefix}_TENFILE.txt · {prefix}_BLOCKS.md ->", outdir)

# =====================================================================================
# SELFTEST — gate phai BAT DUOC loi da xay ra o video 10 (ban v1)
# =====================================================================================
def _selftest():
    v1 = r"E:\Claude\Projects\youtube-jp-showa\06_VIDEO\10_tsugakuro\gen_prompts_v1.py.bak"
    g = {"__name__": "_i"}
    exec(io.open(v1, encoding="utf-8").read(), g)
    S, P, C = g["S"], g["P"], g["C"]
    # v1 dung STYLE/AVOID cu — build lai bang lib de gate soi ACT + FRAMING cua v1
    rows = build(S, P, C)
    n_red, n_warn = gate(rows, S, P, C, whitelist_no_human={"K2": "", "Y1": "", "Y2": "", "E2": "", "E5": "", "E8": "", "E9": "", "E10": ""},
                         interior={"genkan_uchi"}, strict=False, quiet=True)
    reds = collections.Counter()
    # dem theo loai
    acts = {s[0]: s[2] for s in S}; cams = {s[0]: s[4] for s in S}
    hands = [s[0] for s in S if bad_framing(s[4])]
    poss  = [s[0] for s in S if POSSESSIVE.search(s[2])]
    nodir = [s[0] for s in S if MOVE_VERBS.search(s[2].lower()) and not DIRECTION.search(s[2].lower())]
    print("SELFTEST tren S cua video 10 (v1):")
    print(f"  framing khong co than : {len(hands)}  (ky vong >= 21: 21 hands-only + feet-only)  {'OK' if len(hands) >= 21 else 'THIEU'}")
    print(f"     -> {hands}")
    print(f"  A_XXX's               : {len(poss)}  (ky vong 0 — v1 da sua)  {poss}")
    print(f"  di chuyen thieu huong : {len(nodir)}  (ky vong >= 2, trong do H1)  {'OK' if 'H1' in nodir else 'H1 KHONG BI BAT'}")
    print(f"     -> {nodir[:12]}{' ...' if len(nodir) > 12 else ''}")
    print(f"  tong 🔴 {n_red} · ⚠️ {n_warn}")
    ok = len(hands) >= 21 and "H1" in nodir
    print("SELFTEST", "PASS" if ok else "FAIL")
    return 0 if ok else 1

if __name__ == "__main__":
    if "--selftest" in sys.argv: sys.exit(_selftest())
    print(__doc__)

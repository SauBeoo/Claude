# =====================================================================================
# DUNG + GATE + XUAT
# =====================================================================================
OUTDIR = r"E:\Claude\Projects\youtube-jp-showa\06_VIDEO\12_natsu-atarimae"

# `cut` = cho CAT HAN chuoi (doi canh / doi thoi diem trong truyen), khong phai de tranh viet 'out'.
CUT = {
 "H3",          # cold open: tu phong ngu nhay sang gieng — cu soc thu 2, co y cat
 "B2",          # M2 mo bang nhip DEN NOI: di tu bep ra gieng (§8.6c luat 1)
 "C1",          # M3 mo bang nhip DEN NOI: xuong doc toi truong
 "E1",          # M4 mo bang nhip DEN NOI: tu truong ve nha
 "F1",          # M5 mo bang nhip DEN NOI: tu cua truoc vong ra vuon
 # 2026-09-12: moi canh POV deu CAT khoi chuoi — POV la mot cu may khac han,
 # noi no vao canh goc 3 lien truoc la vo nghia (va gate se doi "out").
 "H1",
 "A12",
 "A14",
 "A22",
 "B6",
 "B20",
 "B26",
 "C1",
 "C9",
 "E1",
 "E4",
 "E13",
 "F11",
 "F12",
 "G10",
}
S = autochain(S, cut=CUT)

rows = build(S, P, C, crowd=CROWD)
n_red, n_warn = gate(rows, S, P, C,
                     interior={"zashiki", "daidokoro"},
                     strict=True, crowd=CROWD)
act_report(S, C)
safe, risky, pct = linkage(S)
print("\nNOI AN TOAN: %d/%d moi noi cung boi canh co it nhat mot canh CHAT (%.0f%%)"
      % (safe, risky, pct))

if n_red == 0:
    write_outputs(rows, OUTDIR)
    print("\nXUAT -> %s\\videogen_FLOW.txt | _TENFILE.txt | _BLOCKS.md" % OUTDIR)
else:
    print("\n[CHAN] %d loi do — KHONG xuat file. Sua roi chay lai." % n_red)
sys.exit(1 if n_red else 0)

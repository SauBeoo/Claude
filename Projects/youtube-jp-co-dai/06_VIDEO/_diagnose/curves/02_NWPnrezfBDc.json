 "drops": [
  {
   "t": 30.4,
   "drop": 33.3,
   "cue": "耳元で響く、小さな羽音もない。 / 刺されることも、においのきつい薬に頼ることもないのです。 / ただ、静かな時間だけが、そこに続いていきます。"
  },
  {
   "t": 45.5,
   "drop": 9.5,
   "cue": "どうでしょうか。 / しかもその植物たちは、蚊を寄せつけないだけではありません / 夕暮れの庭を、いっそう美しく彩ってもくれるのです。"
  },
  {
   "t": 75.9,
   "drop": 9.5,
   "cue": "そして最後の第1位は、高級リゾートの庭づくりに関わる人々 / あまり広めたがらないと言われるほどの植物です。 / なぜ、これほどの力が知られていないのか。"
  },
  {
   "t": 197.3,
   "drop": 9.5,
   "cue": "むしろ、栄養が豊かすぎない土のほうが、この花は力を発揮し / 少し痩せた、厳しい環境であるほど、香りの成分が濃くなる傾 / 植えるときは、株と株の間を15センチほど開けてください。"
  },
  {
   "t": 258.1,
   "drop": 9.5,
   "cue": "私たちにとっては、心を落ち着かせる優しい香り。 / ところが蚊にとっては、まったく違って感じられるのです。 / その秘密は、リナロールという天然の成分にあります。"
  },
  {
   "t": 1153.7,
   "drop": 9.5,
   "cue": "およそ4メートルから6メートルほどの範囲に、 / 見えない守りを作り出すと考えられています。 / 低木のまわりに、目に見えない結界が張られている。"
  },
  {
   "t": 1229.6,
   "drop": 9.5,
   "cue": "秋には鮮やかな紫色の実をつけ、鳥を呼び寄せると同時に、庭 / 葉を軽く揉んで肌に使ったり、煮出して自然なスプレーとして / 身近に感じられます。"
  },
  {
   "t": 1320.7,
   "drop": 9.5,
   "cue": "ここで、あらかじめお約束していた、特別な工夫をお伝えしま / どの植物を選んだとしても、その効果を、さらに高めるための / かぎは、重ねて配置することにあります。"
  }
 ],

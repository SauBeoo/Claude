 "srt_folder": "07_natsu-denkidai-suzumi",
 "drops": [
  {
   "t": 29.6,
   "drop": 30.9,
   "cue": "住宅の断熱を調べた業界の試算です。 / 壁でも、屋根でもなく、窓です。 / 内側から布をかぶせても、熱は、もう部屋の中に入っています"
  },
  {
   "t": 44.3,
   "drop": 16.4,
   "cue": "内側から布をかぶせても、熱は、もう部屋の中に入っています / そこで今日、いちばん先にお話しするのは、この二つです。 / すだれの吊り方と、室外機の日除け。"
  },
  {
   "t": 59.1,
   "drop": 5.5,
   "cue": "どちらも数百円から始められて、今日の夕方には終わります。 / あわせて、多くのご家庭が良いと思って続けている、三つの逆 / エアコンのなかった時代、日本人は、すだれと、ひとバケツの"
  },
  {
   "t": 221.7,
   "drop": 5.4,
   "cue": "選ぶときは、窓より一回り大きいものを選んでください。 / 窓とちょうど同じ大きさだと、朝と夕方、日ざしが斜めに差す / 吊る順番は、西向きの窓からです。"
  },
  {
   "t": 236.5,
   "drop": 9.1,
   "cue": "吊る順番は、西向きの窓からです。 / 西の日ざしは、低い角度で入ってくるので、部屋の奥まで届き / 南の窓よりも、西の窓のほうが、効き目を先に感じられます。"
  },
  {
   "t": 325.2,
   "drop": 7.3,
   "cue": "この番組を初めてご覧になる方は、 / よろしければ登録のボタンを押していただけると嬉しいです。 / 一つ、お聞かせください。"
  },
  {
   "t": 384.3,
   "drop": 7.3,
   "cue": "日本の家には、もう一つの仕掛けがありました。 / 深く張り出した軒です。 / 夏の太陽は、空の高いところを通ります。"
  },
  {
   "t": 576.4,
   "drop": 5.4,
   "cue": "ただし、本体そのものに水をかけ続けるのは、避けてください / 電気の部品や、金属の錆のもとになります。 / 影ができれば、設定温度は、無理なく1度戻せます。"
  },
  {
   "t": 650.3,
   "drop": 5.5,
   "cue": "あの何気ない習わしにも、はっきりとした理屈があります。 / 水は、蒸発するときに、まわりから熱を奪います。 / 気化熱と呼ばれるはたらきです。"
  },
  {
   "t": 679.9,
   "drop": 5.4,
   "cue": "汗をかくと涼しくなるのと、まったく同じ仕組みです。 / 地面にまかれた水は、乾きながら、地面の熱を持ち去ってくれ / 打ち水は、もともと、涼しさのためだけのものではありません"
  },
  {
   "t": 709.4,
   "drop": 9.1,
   "cue": "場を清め、木々の葉を生き返らせ、そして涼しさを添える。 / もてなしの作法として、水をまいていたのです。 / 実利と礼儀が、一つになっていた習わしでした。"
  },
  {
   "t": 1034.6,
   "drop": 5.4,
   "cue": "この三か所は、太い血管が、皮膚のすぐ下を通っています。 / そこを冷やせば、冷えた血が体をめぐり、全身が涼しく感じら / 背中や胸をあおぐより、この三か所を冷やすほうが、少ない水"
  },
  {
   "t": 1241.5,
   "drop": 7.3,
   "cue": "手入れをすれば、何年も使えます。 / 打ち水の水は、風呂の残り湯。 / 風の道を作るのに、費用はかかりません。"
  }
 ],
